index 0000000000..745239a0ea
--- /dev/null
+++ b/net/pbr/files/etc/hotplug.d/iface/71-pbr
@@ -0,0 +1,31 @@
+#!/bin/sh
+#SPDX-License-Identifier: GPL-3.0-only
+#Copyright (c) 2024 Qualcomm Innovation Center, Inc. All rights reserved.
+
+#source pbr file
+. /etc/data/qcmapPbrConfig.sh
+
+if [ -x /etc/init.d/pbr ] && [ $(uci get pbr.config.enabled) = "1" ]; then
+	if echo $INTERFACE | grep wan; then
+		num_rmnet=$(grep rmnet /tmp/state/network -c)
+		if echo $ACTION | grep ifup; then
+			#If addional wan coming up reload pbr
+			if [ $num_rmnet -gt 1 ]; then
+				/etc/init.d/pbr reload
+				/etc/data/qcmapPbrConfig.sh delete_conntrack_on_wan_event_pbr $INTERFACE
+			#If first wan coming up start pbr
+			elif [ $num_rmnet -eq 1 ]; then
+				/etc/data/qcmapPbrConfig.sh start_pbr
+			fi
+		elif echo $ACTION | grep ifdown; then
+			#If last wan going down stop pbr
+			if [ $num_rmnet -eq 0 ]; then
+				/etc/data/qcmapPbrConfig.sh stop_pbr
+			#If additional wan going down reload pbr
+			elif [ $num_rmnet -gt 0 ]; then
+				/etc/init.d/pbr reload
+				/etc/data/qcmapPbrConfig.sh delete_conntrack_on_wan_event_pbr $INTERFACE
+			fi
+		fi
+	fi
+fi
