From a43f42aee697a4c7ff530abb18948f8a0f97249c Mon Sep 17 00:00:00 2001
From: Ruixuan Gu <quic_ruixgu@quicinc.com>
Date: Tue, 14 Nov 2023 13:22:59 +0800
Subject: [PATCH] Tinyproxy: modify tinyproxy.init script to support upstream

Signed-off-by: Ruixuan Gu <quic_ruixgu@quicinc.com>
---
 net/tinyproxy/files/tinyproxy.init | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/net/tinyproxy/files/tinyproxy.init b/net/tinyproxy/files/tinyproxy.init
index 1feac669c..bc1a5868a 100644
--- a/net/tinyproxy/files/tinyproxy.init
+++ b/net/tinyproxy/files/tinyproxy.init
@@ -17,17 +17,19 @@ write_upstream() {
 	local type
 	local via
 	local target
+	local protocol
 
 	config_get "type" "$1" "type"
 	config_get via "$1" via
 	config_get target "$1" target
-	[ -n "$target" ] && target=' "'"$target"'"'
+	config_get protocol "$1" protocol
+	[ -n "$target" ] && \
 
-	[ "$type" = "proxy" ] && [ -n "$via" ] && \
-		echo "upstream $via$target"
+	[ "$type" = "proxy" ] && [ -n "$protocol" ] && \
+		echo "upstream $protocol $via $target"
 
 	[ "$type" = "reject" ] && [ -n "$target" ] && \
-		echo "no upstream$target"
+		echo "no upstream $protocol $target"
 }
 
 proxy_atom() {
@@ -139,6 +141,7 @@ start_proxy() {
 	procd_set_param command "$PROG"
 	procd_append_param command -c "$CFGFILE"
 	procd_append_param command -d
+	procd_set_param pidfile /var/run/tinyproxy.pid
 	procd_close_instance
 }
 
-- 
