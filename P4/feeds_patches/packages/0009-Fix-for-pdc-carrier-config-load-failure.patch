Subject: [PATCH] Fix-for-pdc-carrier-config-load-failure

---
 ...-for-pdc-carrier-config-load-failure.patch | 33 +++++++++++++++++++
 1 file changed, 33 insertions(+)
 create mode 100644 net/modemmanager/patches/0006-Fix-for-pdc-carrier-config-load-failure.patch

diff --git a/net/modemmanager/patches/0006-Fix-for-pdc-carrier-config-load-failure.patch b/net/modemmanager/patches/0006-Fix-for-pdc-carrier-config-load-failure.patch
new file mode 100644
index 0000000..aa960a8
--- /dev/null
+++ b/net/modemmanager/patches/0006-Fix-for-pdc-carrier-config-load-failure.patch
@@ -0,0 +1,33 @@
