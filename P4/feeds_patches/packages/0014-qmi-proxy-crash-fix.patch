---
 .../patches/0001-QMI_PROXY_CRASH_FIX.patch    | 37 +++++++++++++++++++
 1 file changed, 37 insertions(+)
 create mode 100644 libs/libqrtr-glib/patches/0001-QMI_PROXY_CRASH_FIX.patch

diff --git a/libs/libqrtr-glib/patches/0001-QMI_PROXY_CRASH_FIX.patch b/libs/libqrtr-glib/patches/0001-QMI_PROXY_CRASH_FIX.patch
new file mode 100644
index 0000000..b783ffa
--- /dev/null
