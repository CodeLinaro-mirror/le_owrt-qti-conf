+From b124b97571556036314122d3fa068e5be75176e2 Mon Sep 17 00:00:00 2001
+From: Krishnapriya Kunhikannan <kkunhika@qti.qualcomm.com>
+Date: Wed, 27 Aug 2025 10:30:05 +0530
+Subject: [PATCH] ModemManager dispose during connecting crash fix
+
+---
+ src/mm-bearer-qmi.c | 16 ++++++++++++++++
+ 1 file changed, 16 insertions(+)
+
+diff --git a/src/mm-bearer-qmi.c b/src/mm-bearer-qmi.c
+index 54f2e93..cbf0475 100644
+--- a/src/mm-bearer-qmi.c
++++ b/src/mm-bearer-qmi.c
+@@ -2994,6 +2994,22 @@ static void
+ dispose (GObject *object)
+ {
+     MMBearerQmi *self = MM_BEARER_QMI (object);
++    MMBaseBearer *base_bearer = MM_BASE_BEARER(self);
++    MMModemState state = MM_MODEM_STATE_UNKNOWN;
++
++    state = mm_base_bearer_get_status (base_bearer);
++
++    /* Cancel cancellable object if modem is in connecting state */
++    if(MM_MODEM_STATE_CONNECTING == state)
++    {
++        mm_obj_info(self,"Modem state is (%d) on dispose",state);
++
++        if(self->priv->ongoing_connect_user_cancellable)
++            g_cancellable_cancel (self->priv->ongoing_connect_user_cancellable);
++
++        if(self->priv->ongoing_connect_network_cancellable)
++            g_cancellable_cancel (self->priv->ongoing_connect_network_cancellable);
++    }
+ 
+     g_assert (!self->priv->ongoing_connect_user_cancellable);
+     g_assert (!self->priv->ongoing_connect_network_cancellable);
+-- 
+2.34.1
+
