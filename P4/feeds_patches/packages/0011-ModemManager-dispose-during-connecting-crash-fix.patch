---
 ...-dispose-during-connecting-crash-fix.patch | 45 +++++++++++++++++++
 1 file changed, 45 insertions(+)
 create mode 100644 net/modemmanager/patches/0008-ModemManager-dispose-during-connecting-crash-fix.patch

diff --git a/net/modemmanager/patches/0008-ModemManager-dispose-during-connecting-crash-fix.patch b/net/modemmanager/patches/0008-ModemManager-dispose-during-connecting-crash-fix.patch
new file mode 100644
index 0000000..d67bc26
--- /dev/null
+++ b/net/modemmanager/patches/0008-ModemManager-dispose-during-connecting-crash-fix.patch
