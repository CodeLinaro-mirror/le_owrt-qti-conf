+index 95b02c2..5e57fb9 100644
+--- a/test/tr181-device_rpcs/mod_dmproxy.odl
++++ b/test/tr181-device_rpcs/mod_dmproxy.odl
+@@ -71,6 +71,7 @@
+ 
+ import "mod-dmproxy.so" as "proxy";
