+ .../tr181-device_test.odl                     |  1 +
+ test/tr181-device_rpcs/mod_dmproxy.odl        |  1 +
+ .../tr181-device_test.odl                     |  1 +
+ 14 files changed, 57 insertions(+), 30 deletions(-)
+ create mode 100644 odl/tr181-device_vars.odl
+
