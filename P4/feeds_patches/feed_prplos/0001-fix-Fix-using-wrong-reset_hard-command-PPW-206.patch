+index 19403bc..36312af 100644
+--- a/makefile
++++ b/makefile
+@@ -34,6 +34,7 @@ install: all
+ 	$(INSTALL) -D -p -m 0644 odl/$(COMPONENT).odl $(DEST)/etc/amx/$(COMPONENT)/$(COMPONENT).odl
+ 	$(INSTALL) -D -p -m 0644 odl/extensions/00_device-device_mapping.odl $(DEST)/etc/amx/$(COMPONENT)/extensions/00_device-device_mapping.odl
+ 	$(INSTALL) -D -p -m 0644 odl/$(COMPONENT)_definition.odl $(DEST)/etc/amx/$(COMPONENT)/$(COMPONENT)_definition.odl
++	$(INSTALL) -D -p -m 0644 odl/$(COMPONENT)_vars.odl $(DEST)/etc/amx/$(COMPONENT)/$(COMPONENT)_vars.odl
+ 	$(INSTALL) -D -p -m 0644 odl/extensions/$(COMPONENT)_usp.odl $(DEST)/etc/amx/$(COMPONENT)/extensions/$(COMPONENT)_usp.odl
+ 	$(INSTALL) -d -m 0755 $(D)//etc/amx/$(COMPONENT)/defaults.d
+ 	$(INSTALL) -D -p -m 0644 odl/amx-processmonitor/test-tr181-device.odl $(DEST)/etc/amx/amx-processmonitor/defaults.d/00-test-tr181-device.odl
+@@ -49,6 +50,7 @@ package: all
+ 	$(INSTALL) -D -p -m 0644 odl/$(COMPONENT).odl $(PKGDIR)/etc/amx/$(COMPONENT)/$(COMPONENT).odl
+ 	$(INSTALL) -D -p -m 0644 odl/extensions/00_device-device_mapping.odl $(PKGDIR)/etc/amx/$(COMPONENT)/extensions/00_device-device_mapping.odl
+ 	$(INSTALL) -D -p -m 0644 odl/$(COMPONENT)_definition.odl $(PKGDIR)/etc/amx/$(COMPONENT)/$(COMPONENT)_definition.odl
++	$(INSTALL) -D -p -m 0644 odl/$(COMPONENT)_vars.odl $(PKGDIR)/etc/amx/$(COMPONENT)/$(COMPONENT)_vars.odl
+ 	$(INSTALL) -D -p -m 0644 odl/extensions/$(COMPONENT)_usp.odl $(PKGDIR)/etc/amx/$(COMPONENT)/extensions/$(COMPONENT)_usp.odl
+ 	$(INSTALL) -d -m 0755 $(D)//etc/amx/$(COMPONENT)/defaults.d
+ 	$(INSTALL) -D -p -m 0644 odl/amx-processmonitor/test-tr181-device.odl $(PKGDIR)/etc/amx/amx-processmonitor/defaults.d/00-test-tr181-device.odl
+@@ -69,6 +71,7 @@ doc:
+ 	$(eval ODLFILES += odl/$(COMPONENT).odl)
+ 	$(eval ODLFILES += odl/extensions/00_device-device_mapping.odl)
+ 	$(eval ODLFILES += odl/$(COMPONENT)_definition.odl)
++	$(eval ODLFILES += odl/$(COMPONENT)_vars.odl)
+ 	$(eval ODLFILES += odl/extensions/$(COMPONENT)_usp.odl)
+ 	$(eval ODLFILES += odl/amx-processmonitor/test-tr181-device.odl)
+ 
+diff --git a/makefile.inc b/makefile.inc
+index 2c31d02..c9f71e9 100644
+--- a/makefile.inc
++++ b/makefile.inc
+@@ -46,7 +46,3 @@ PROCMONDIR ?= $(PREFIX)lib/processmonitor/scripts
+ 
+ # default config options
+ CONFIG_SAH_AMX_TR181_DEVICE_ORDER ?= 41
+-ifeq ($(DEFINE_ALL_BOOLEANS),y)
