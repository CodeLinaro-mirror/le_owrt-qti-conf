+diff --git a/mod-debug-info/src/mod_debug_info_start.c b/mod-debug-info/src/mod_debug_info_start.c
+index 1d6815b..374fff5 100644
+--- a/mod-debug-info/src/mod_debug_info_start.c
++++ b/mod-debug-info/src/mod_debug_info_start.c
+@@ -75,7 +75,6 @@
