+-  CONFIG_SAH_AMX_TR181_DEVICE_RESET_HARD_ENABLE:
+-    depends: CONFIG_SAH_AMX_TR181_DEVICE
+-    default: y
+-    type: bool
+-    description: "Custom using FactoryReset() rpc call reset_hard or firstboot -y"
+ 
+ makefiles:
+   compile:
+@@ -63,6 +58,9 @@ artifacts:
+ - source: "odl/$(COMPONENT)_definition.odl"
+   destination: "/etc/amx/$(COMPONENT)/$(COMPONENT)_definition.odl"
+   permissions: "0644"
++- source: "odl/$(COMPONENT)_vars.odl"
++  destination: "/etc/amx/$(COMPONENT)/$(COMPONENT)_vars.odl"
++  permissions: "0644"
+ - source: "odl/extensions/$(COMPONENT)_usp.odl"
+   destination: "/etc/amx/$(COMPONENT)/extensions/$(COMPONENT)_usp.odl"
+   permissions: "0644"
