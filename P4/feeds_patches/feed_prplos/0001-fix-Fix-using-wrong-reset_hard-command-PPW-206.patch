+ #include "mod_debug_info.h"
+ 
+-#define STRING_IS_NULL(x)   ((x) == NULL) || (strcmp(x, "(null)") == 0)
+ // module trace zone
+ #define ME "mod-debug"
+ 
+diff --git a/odl/tr181-device.odl b/odl/tr181-device.odl
+index 2e79a5a..79c732b 100644
+--- a/odl/tr181-device.odl
++++ b/odl/tr181-device.odl
+@@ -31,20 +31,13 @@
+         register-on-start-event = true,
+         use-async-handlers = true
+     };
+-
+-    // reboot timeout in seconds: If a graceful shutdown does not finish after "reboot_timeout" seconds, a hard reboot is triggered
+-    reboot_timeout = 300;
+-
+-    mod-dir = "/usr/lib/amx/${name}/modules";
+-
+-    // Name convention of the getDebugInformation output - FIXED: default one by the script, SERIAL_TIMESTAMP: <serialNumber of device>_<timestamp>.tgz
+-    debugname = "SERIAL_TIMESTAMP";
+ }
+ 
+ import "mod-dmext.so";
+ import "mod-dmproxy.so" as "proxy";
+ import "${name}.so" as "tr181-device";
+ 
++include "${name}_vars.odl";
+ include "${definition_file}";
+ include "${defaults_dir}";
+ 
+diff --git a/odl/tr181-device_vars.odl b/odl/tr181-device_vars.odl
+new file mode 100644
+index 0000000..d887836
+--- /dev/null
++++ b/odl/tr181-device_vars.odl
+@@ -0,0 +1,10 @@
++%config {
++    // reboot timeout in seconds: If a graceful shutdown does not finish after "reboot_timeout" seconds, a hard reboot is triggered
++    %global reboot_timeout = 300;
++
++    %global mod-dir = "/usr/lib/amx/${name}/modules";
++    %global reset_hard_path = "/usr/bin/reset_hard";
++
++    // Name convention of the getDebugInformation output - FIXED: default one by the script, SERIAL_TIMESTAMP: <serialNumber of device>_<timestamp>.tgz
++    %global debugname = "SERIAL_TIMESTAMP";
++}
+\ No newline at end of file
+diff --git a/src/device_rpc_calls.c b/src/device_rpc_calls.c
+index e94e4cc..237f738 100644
+--- a/src/device_rpc_calls.c
++++ b/src/device_rpc_calls.c
+@@ -89,6 +89,9 @@
+ #define IS_REBOOT_CAUSE_VALID(cause) is_valid_args(reboot_causes, sizeof(reboot_causes) / sizeof(reboot_causes[0]), cause)
+ #define IS_FACTORY_RESET_CAUSE_VALID(cause) is_valid_args(facreset_causes, sizeof(facreset_causes) / sizeof(facreset_causes[0]), cause)
+ 
++#define CMD_RESET_HARD "reset_hard"
++#define CMD_FIRSTBOOT "firstboot"
++
+ /**********************************************************
+ * Type definitions
+ **********************************************************/
+@@ -243,21 +246,36 @@ amxd_status_t _SendBootEvent(UNUSED amxd_object_t* object, UNUSED amxd_function_
+     return ret_status;
+ }
+ 
++static const cstring_t reset_hard_command(bool use_reset_hard) {
++    if(use_reset_hard) {
++        return CMD_RESET_HARD;
++    } else {
++        return CMD_FIRSTBOOT;
++    }
++}
++
+ static int reset_hard(void) {
+     int status = -1;
+     amxp_subproc_t* proc = NULL;
++    const cstring_t cmd = NULL;
++    bool use_reset_hard = false;
++    const cstring_t filename = device_get_reset_hard_path();
+ 
++    if((STRING_EMPTY(filename) == false) && (access(filename, F_OK) == 0)) {
++        use_reset_hard = true;
++    }
++
++    cmd = reset_hard_command(use_reset_hard);
+     amxp_subproc_new(&proc);
+-#if CONFIG_SAH_AMX_TR181_DEVICE_RESET_HARD_ENABLE
+-    amxp_subproc_start_wait(proc, 2000, (char*) "reset_hard", NULL);
+-    SAH_TRACEZ_INFO(ME, "Factory_Reset execute reset_hard");
+-#else
+-    amxp_subproc_start_wait(proc, 2000, (char*) "firstboot", "-y", NULL);
+-    SAH_TRACEZ_INFO(ME, "Factory_Reset execute firstboot");
+-#endif
++    SAH_TRACEZ_INFO(ME, "Factory_Reset execute %s", cmd);
++    if(use_reset_hard) {
++        amxp_subproc_start_wait(proc, 2000, (char*) cmd, NULL);
++    } else {
++        amxp_subproc_start_wait(proc, 2000, (char*) cmd, "-y", NULL);
++    }
+ 
+     status = amxp_subproc_get_exitstatus(proc);
+-    when_failed_trace(status, exit, ERROR, "Failed to execute factory reset command, with error code: (%i)", status);
++    when_failed_trace(status, exit, ERROR, "Failed to execute factory reset command '%s', with error code: (%i)", cmd, status);
+     status = 0;
+ 
+ exit:
+diff --git a/src/makefile b/src/makefile
+index 28ad5d4..7562610 100644
+--- a/src/makefile
++++ b/src/makefile
+@@ -31,10 +31,6 @@ else
+ 	CFLAGS += -Wstrict-prototypes -Wold-style-definition -Wnested-externs -std=c11
+ endif
+ 
+-ifeq ($(CONFIG_SAH_AMX_TR181_DEVICE_RESET_HARD_ENABLE),y)
+-    CFLAGS += -DCONFIG_SAH_AMX_TR181_DEVICE_RESET_HARD_ENABLE
+-endif
+-
+ LDFLAGS += $(STAGING_LIBDIR) \
+            -shared -fPIC \
+            -lamxc -lamxp -lamxd -lamxo -lamxm -lsahtrace
+diff --git a/src/tr181-device_main.c b/src/tr181-device_main.c
+index d062d20..38e7c21 100644
+--- a/src/tr181-device_main.c
++++ b/src/tr181-device_main.c
+@@ -153,6 +153,12 @@ amxd_dm_t* device_get_dm(void) {
+     return app.dm;
+ }
+ 
++const char* device_get_reset_hard_path(void) {
++    amxc_var_t* setting = amxo_parser_get_config(app.parser, "reset_hard_path");
++    const char* prefix = amxc_var_constcast(cstring_t, setting);
++    return (prefix != NULL) ? prefix : "";
++}
++
+ int _device_main(int reason,
+                  amxd_dm_t* dm,
+                  amxo_parser_t* parser) {
