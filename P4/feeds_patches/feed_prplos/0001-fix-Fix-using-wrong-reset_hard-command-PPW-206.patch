+--- a/include_priv/device.h
++++ b/include_priv/device.h
+@@ -86,6 +86,9 @@ extern "C"
+ 
+ #define ME "device"
+ 
++#define STRING_IS_NULL(x)   ((x) == NULL) || (strcmp(x, "(null)") == 0)
++#define STRING_EMPTY(TEXT) ((STRING_IS_NULL(TEXT)) || (*TEXT == 0))
++
+ typedef struct _device_app {
+     amxd_dm_t* dm;
+     amxo_parser_t* parser;
+@@ -97,6 +100,7 @@ amxb_bus_ctx_t* device_get_ctx(void);
+ amxo_parser_t* device_get_parser(void);
+ int device_get_timeout(void);
+ amxd_dm_t* device_get_dm(void);
++const char* device_get_reset_hard_path(void);
+ 
+ int _device_main(int reason,
+                  amxd_dm_t* dm,
