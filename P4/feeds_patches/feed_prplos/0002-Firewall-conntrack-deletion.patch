++/****************************************************************************
++ **
++ ** Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
++ ** SPDX-License-Identifier: BSD-3-Clause-Clear
++ **
++ **
++ ****************************************************************************/
++#include "mod_fw_conntrack.h"
++
++static AMXM_CONSTRUCTOR module_start(void) {
++    SAH_TRACEZ_IN(ME);
++    amxm_shared_object_t* so = amxm_so_get_current();
++    amxm_module_t* mod = NULL;
++
++    amxm_module_register(&mod, so, MOD_FW_CONNTRACK);
++    amxm_module_add_function(mod, "blacklist-conntrack", blacklist_conntrack);
++    amxm_module_add_function(mod, "whitelist-conntrack", whitelist_conntrack);
++    amxm_module_add_function(mod, "add-mark-fw-rule", add_mark_fw_rule);
++    amxm_module_add_function(mod, "del-mark-fw-rule", del_mark_fw_rule);
++
++    handle = dlopen(MOD_PATH, RTLD_LAZY);
++    if (!handle) {
++        SAH_TRACEZ_ERROR(ME, "dlopen error: %s\n", dlerror());
++        return 1;
++    }
++    SAH_TRACEZ_OUT(ME);
++    return 0;
++}
++
++//Function to fetch the five tuple args from amxc_var_t* args
++void fetch_five_tuple(amxc_var_t* args, char** src_ip, char** dst_ip, int* src_port, int* dst_port, int* protocol) {
++    *src_ip = args[0].data.s;
++    *dst_ip = args[1].data.s;
++    *src_port = args[2].data.i32;
++    *dst_port = args[3].data.i32;
++    *protocol = args[4].data.i32;
++}
++
++//Function to invoke blacklist delete conntrack API
++static int blacklist_conntrack(UNUSED const char* function_name,
++        UNUSED amxc_var_t* args,
++        UNUSED amxc_var_t* ret) {
++    SAH_TRACEZ_INFO(ME, "conntrack deletion for blacklist");
++
++    int (*blacklist_function)(char*, char*, int, int, int, char*, int, char*);
++    blacklist_function = dlsym(handle, "BlacklistDeleteConntrack");
++    if (!blacklist_function) {
++        SAH_TRACEZ_ERROR(ME, "Error linking blacklist function: %s\n", dlerror());
++        return 1;
++    }
++
++    char *src_ip = NULL, *dst_ip = NULL;
++    int src_port = 0, dst_port = 0, protocol = 0;
++    fetch_five_tuple(args, &src_ip, &dst_ip, &src_port, &dst_port, &protocol);
++
++    char* wan_ip = args[6].data.s;
++    int ip_version = args[7].data.i32;
++    char* wan_interface = args[8].data.s;
++
++    //invoke blacklist API for handling UL traffic IPv4/v6
++    blacklist_function(dst_ip, src_ip, src_port, dst_port, protocol, wan_ip, ip_version, wan_interface);
++    if(ip_version == IPv4_VERSION ){
++        //invoke blacklist API for handling DL traffic IPv4
++        blacklist_function(src_ip, wan_ip, src_port, dst_port, protocol, wan_ip, ip_version, wan_interface);
++    }
++    if(ip_version == IPv6_VERSION){
++        //invoke blacklist API for handling DL traffic IPv6
++        blacklist_function(src_ip, dst_ip, src_port, dst_port, protocol, wan_ip, ip_version, wan_interface);
++    }
++    return 0;
++}
++
++//Function to invoke whitelist delete conntrack API
++static int whitelist_conntrack(UNUSED const char* function_name,
++        UNUSED amxc_var_t* args,
++        UNUSED amxc_var_t* ret) {
++
++    SAH_TRACEZ_INFO(ME, "conntrack deletion for whitelist");
++
++    int (*whitelist_function)(char*, char*, int, int, int, char*, char*, int, char*);
++    whitelist_function = dlsym(handle, "WhitelistDeleteConntrack");
++    if (!whitelist_function) {
++        SAH_TRACEZ_ERROR(ME, "Error linking whitelist function: %s\n", dlerror());
++        return 1;
++    }
++
++    char *src_ip = NULL, *dst_ip = NULL;
++    int src_port = 0, dst_port = 0, protocol = 0;
++    fetch_five_tuple(args, &src_ip, &dst_ip, &src_port, &dst_port, &protocol);
++
++    char* lan_ip = args[5].data.s;
++    char* wan_ip = args[6].data.s;
++    int ip_version = args[7].data.i32;
++    char* wan_interface = args[8].data.s;
++
++    //invoke whitelist API for handling UL traffic IPv4/v6
++    whitelist_function(dst_ip, src_ip, src_port, dst_port, protocol, lan_ip, wan_ip, ip_version, wan_interface);
++    if(ip_version == IPv4_VERSION){
++        //invoke whitelist API for handling DL traffic IPv4
++        whitelist_function(src_ip, wan_ip, src_port, dst_port, protocol, lan_ip, wan_ip, ip_version, wan_interface);
++    }
++    if(ip_version == IPv6_VERSION){
++        //invoke whitelist API for handling DL traffic IPv6
++        whitelist_function(src_ip, dst_ip, src_port, dst_port, protocol, lan_ip, wan_ip, ip_version, wan_interface);
++    }
++
++    return 0;
++}
++
++/*Function to add rules to mangle table with mark
++ *args[] contains the informations required to build the mangle table rule
++ */
++static int add_mark_fw_rule(UNUSED const char* function_name,
++        UNUSED amxc_var_t* args,
++        UNUSED amxc_var_t* ret) {
++
++    SAH_TRACEZ_INFO(ME,"add mark rule function");
++
++    int (*add_mark_rule_function)(const char*, char*, char*, int, int, int, char*);
++    add_mark_rule_function = dlsym(handle, "AddOrDelMarkFWRule");
++    if (!add_mark_rule_function) {
++        SAH_TRACEZ_ERROR(ME, "Error linking mark_rule function: %s\n", dlerror());
++        return 1;
++    }
++    //Fetching the corresponding values from args[]
++    char* src_ip = args[0].data.s;
++    char* dst_ip = args[1].data.s;
++    int dst_port = args[3].data.i32;
++    int protocol = args[4].data.i32;
++    int ip_version = args[5].data.i32;
++    char* wan_ip = args[6].data.s;
++
++    SAH_TRACEZ_INFO(ME, "rule parameters: src_ip:%s, dst_ip:%s, dst_port:%d, protocol:%d",
++            src_ip, dst_ip, dst_port, protocol);
++    //Invoking the function in mod-qcom-conntrack module to add the rule
++    add_mark_rule_function(ADD, src_ip, dst_ip, dst_port, protocol, ip_version, wan_ip);
++    return 0;
++}
++
++/*Function to delete rules in mangle table with mark
++ *args[] contains the infos required to delete the mangle table rule
++ */
++static int del_mark_fw_rule(UNUSED const char* function_name,
++        UNUSED amxc_var_t* args,
++        UNUSED amxc_var_t* ret) {
++
++    SAH_TRACEZ_INFO(ME,"delete mark rule function");
++
++    int (*del_mark_rule_function)(const char*, char*, char*, int, int, int, char*);
++    del_mark_rule_function = dlsym(handle, "AddOrDelMarkFWRule");
++    if (!del_mark_rule_function) {
++        SAH_TRACEZ_ERROR(ME, "Error linking mark_rule function: %s\n", dlerror());
++        return 1;
++    }
++    //Fetching the corresponding values from args[]
++    char* src_ip = args[0].data.s;
++    char* dst_ip = args[1].data.s;
++    int dst_port = args[3].data.i32;
++    int protocol = args[4].data.i32;
++    int ip_version = args[5].data.i32;
++    char* wan_ip = args[6].data.s;
++
++    SAH_TRACEZ_INFO(ME, "rule parameters: src_ip:%s, dst_ip:%s, dst_port:%d, protocol:%d",
++            src_ip, dst_ip, dst_port, protocol);
++    //Invoking the function in mod-qcom-conntrack module to delete the rule
++    del_mark_rule_function(DEL, src_ip, dst_ip, dst_port, protocol, ip_version, wan_ip);
++    return 0;
++}
++/*Destructor function to close the handle*/
++static AMXM_DESTRUCTOR module_stop(void) {
++    SAH_TRACEZ_IN(ME);
++    dlclose(handle);
++    SAH_TRACEZ_OUT(ME);
++    return 0;
++}
