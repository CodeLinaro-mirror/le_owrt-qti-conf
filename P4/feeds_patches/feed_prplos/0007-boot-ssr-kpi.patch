+diff --git a/mod-cellular-qcmap/include_priv/mod-cellular-qcmap.h b/mod-cellular-qcmap/include_priv/mod-cellular-qcmap.h
+index d7fb006..f074c1e 100644
+--- a/mod-cellular-qcmap/include_priv/mod-cellular-qcmap.h
++++ b/mod-cellular-qcmap/include_priv/mod-cellular-qcmap.h
+@@ -17,0 +18 @@ int modem_ind_register(const char* function_name, amxc_var_t* args, amxc_var_t*
++int set_ssrkpi_flag(const char* function_name, amxc_var_t* args, amxc_var_t* ret);
+diff --git a/mod-cellular-qcmap/src/mod-cellular-qcmap.c b/mod-cellular-qcmap/src/mod-cellular-qcmap.c
+index adb146b..3d17021 100644
+--- a/mod-cellular-qcmap/src/mod-cellular-qcmap.c
++++ b/mod-cellular-qcmap/src/mod-cellular-qcmap.c
+@@ -37,0 +38,8 @@ static AMXM_CONSTRUCTOR qcmap_module_start(void) {
++
++    // Register SSR KPI state
++    ret = amxm_module_add_function(mod, "set-ssrkpi-flag", set_ssrkpi_flag);
++    if (ret != 0) {
++        SAH_TRACEZ_ERROR(ME, "Failed to set SSR KPI flag (ret = %d)", ret);
++        return ret;
++    }
++
+diff --git a/mod-cellular-qcmap/src/mod-cellular-qcmap_apis.c b/mod-cellular-qcmap/src/mod-cellular-qcmap_apis.c
+index efc59c0..c914cbc 100644
+--- a/mod-cellular-qcmap/src/mod-cellular-qcmap_apis.c
++++ b/mod-cellular-qcmap/src/mod-cellular-qcmap_apis.c
+@@ -12,0 +13,3 @@
++static const char* prev_modem_status = "MODEM_STATUS_UP";
++static int ssr_kpi_flag = 0;
++
+@@ -31,2 +34 @@ static void mod_hal_cellular_qcmap_event_handler(modem_status_t status_ind) {
+-    const char* modem_status;
+-    modem_status = (status_ind == 0) ? "MODEM_STATUS_UP" :
++    const char* curr_modem_status = (status_ind == 0) ? "MODEM_STATUS_UP" :
+@@ -37 +39 @@ static void mod_hal_cellular_qcmap_event_handler(modem_status_t status_ind) {
+-    if (strncmp(modem_status, "MODEM_STATUS_UNKNOWN", strlen("MODEM_STATUS_UNKNOWN")) == 0) {
++    if (strncmp(curr_modem_status, "MODEM_STATUS_UNKNOWN", strlen("MODEM_STATUS_UNKNOWN")) == 0) {
+@@ -40,2 +42,10 @@ static void mod_hal_cellular_qcmap_event_handler(modem_status_t status_ind) {
+-    SAH_TRACEZ_INFO(ME, "Passing string to libmm_handle_ssr: %s", modem_status);
+-    libmm_handle_ssr_event(modem_status);
++    SAH_TRACEZ_INFO(ME, "Passing string to libmm_handle_ssr: %s", curr_modem_status);
++    libmm_handle_ssr_event(curr_modem_status);
++
++    // Reset SSR KPI state
++    if ((strncmp(prev_modem_status, "MODEM_STATUS_DOWN", strlen("MODEM_STATUS_DOWN")) == 0) &&
++        (strncmp(curr_modem_status, "MODEM_STATUS_UP", strlen("MODEM_STATUS_UP")) == 0)) {
++         SAH_TRACEZ_INFO(ME, "Entering SSR reset_kpi_state: %d", ssr_kpi_flag);
++         ssr_kpi_flag = 1;
++    }
++    prev_modem_status = curr_modem_status;
+@@ -85,0 +96,38 @@ exit:
++/*===========================================================================
++FUNCTION:  set_ssrkpi_flag
++===========================================================================*/
++/*!
++@brief
++Sets a flag indicating the status of Subsystem Restart (SSR) KPI collection.
++This function is typically called to enable or disable the KPI collection based on
++provided arguments.
++@param
++function_name - Unused parameter.
++@param
++args - Arguments passed to the function, expected to contain the flag value.
++@param
++ret - Unused parameter for return value.
++@return
++int - 0 on success, or an error code if the argument parsing fails or the flag cannot be set.
++*/
++/*=========================================================================*/
++int set_ssrkpi_flag(UNUSED const char* function_name,
++                    amxc_var_t* args,
++                    UNUSED amxc_var_t* ret) {
++
++    SAH_TRACEZ_IN(ME);
++    SAH_TRACEZ_INFO(ME, "Entering function set_ssrkpi_flag");
++
++    int rv = -1;
++    when_null_trace(args, exit, ERROR, "No arguments provided");
++
++    if (ssr_kpi_flag) {
++        SAH_TRACEZ_INFO(ME, "SSR KPI Flag set done, ssr_kpi_flag=%d", ssr_kpi_flag);
++        rv = 0;
++    }
++
++exit:
++    SAH_TRACEZ_INFO(ME, "End of function set_ssrkpi_flag");
++    SAH_TRACEZ_OUT(ME);
++    return rv;
++}
+\ No newline at end of file
+diff --git a/odl/cellular-manager_definition.odl b/odl/cellular-manager_definition.odl
+index 8dd2d37..5fdfed8 100644
+--- a/odl/cellular-manager_definition.odl
++++ b/odl/cellular-manager_definition.odl
+@@ -55,0 +56,9 @@
++        /**
++         * Function that gives indication form the IP Manager that IP has been assigned on qmapmux interface.
++         * bool IPv4Type true indicates IPv4.
++         * bool IPv4Type false indicates IPv6.
++         *
++         * @version V1.0
++         */
++        %protected void NotifyIPAssigned(%mandatory bool IPv4Type);
++
+diff --git a/src/dm_cellular_rpc.c b/src/dm_cellular_rpc.c
+new file mode 100644
+index 0000000..9bbfb9a
+--- /dev/null
++++ b/src/dm_cellular_rpc.c
+@@ -0,0 +1,302 @@
++#include <stdio.h>
++#include <stdlib.h>
++#include <string.h>
++
++#include <debug/sahtrace.h>
++#include <debug/sahtrace_macros.h>
++#include <amxc/amxc.h>
++#include <amxp/amxp.h>
++#include <amxd/amxd_dm.h>
++#include <amxb/amxb.h>
++
++#include "cellular_priv.h"
++#include "cellular_utils.h"
++#include "cellular_rpc.h"
++#include "cellular_soc_utils.h"
++
++#define ME "events"
++
++#define IPv4BitMask 0x1
++#define IPv6BitMask 0x2
++#define IP_WAIT_TIMER_MS 2000
++
++static cellular_t cellular;
++static bool is_kpi_logging_enabled = true;
++static int ip_received_status = 0;
++
++/**
++ * @brief Reset KPI logging state for SSR.
++ *
++ * Resets the IP received status and KPI logging flag to allow KPI logging again.
++ */
++static void reset_ssr_kpi_state(void) {
++    SAH_TRACEZ_INFO(ME, "Resetting KPI logging state for SSR");
++    is_kpi_logging_enabled = true;
++    ip_received_status = 0;
++}
++
++/**
++ * @brief Log KPI information for IP address assignment.
++ *
++ * Logs KPI for the assignment of an IP address (IPv4 or IPv6) to a profile.
++ *
++ * @param[in] ipv4_type   A boolean indicating whether the IP address is IPv4.
++ * @param[in] profile_id  The profile ID associated with the APN.
++ */
++static void log_ip_kpi(UNUSED bool ipv4_type, UNUSED int profile_id) {
++    SAH_TRACEZ_IN(ME);
++
++    // Open the file directly instead of using shell commands
++    FILE* kpi_file = fopen(BOOT_KPI_NODE, "a");
++    if (!kpi_file) {
++        SAH_TRACEZ_ERROR(ME, "Failed to open KPI file %s", BOOT_KPI_NODE);
++        SAH_TRACEZ_OUT(ME);
++        return;
++    }
++
++    const char* ip_version = ipv4_type ? "IPV4" : "IPV6";
++    if (fprintf(kpi_file, "M - PRPL Network %s Address Assigned Profile:%d", ip_version, profile_id) > 0) {
++        SAH_TRACEZ_INFO(ME, "Logged %s address assignment to %s with profile %d",
++                        ip_version, BOOT_KPI_NODE, profile_id);
++    } else {
++        SAH_TRACEZ_ERROR(ME, "Failed to write KPI: %s Address Assigned Profile:%d", ip_version, profile_id);
++    }
++
++    fclose(kpi_file);
++    SAH_TRACEZ_OUT(ME);
++}
++
++/**
++ * @brief Timer callback for delayed IP in ipv4v6 case.
++ *
++ * Logs KPI for the missing IP (IPv4 or IPv6) after timeout.
++ *
++ * @param[in] timer The timer object.
++ * @param[in] data  User data (profile_id and expected IP type).
++ */
++static void ip_timeout_cb(amxp_timer_t* timer, void* data) {
++    SAH_TRACEZ_IN(ME);
++
++    timer_data_t* timer_data = data;
++    amxp_timer_stop(timer);
++    amxp_timer_delete(&timer);
++
++    SAH_TRACEZ_INFO(ME, "Timer expired for %s, profile %d",
++                    timer_data->ipv4_type ? "IPv4" : "IPv6",
++                    timer_data->profile_id);
++
++    log_ip_kpi(timer_data->ipv4_type, timer_data->profile_id);
++    free(timer_data);
++
++    SAH_TRACEZ_OUT(ME);
++}
++
++/**
++ * @brief Disable KPI logging if all expected IPs are received.
++ *
++ * Checks if all expected IPs for the APN type are received and disables KPI logging
++ * to prevent logging on bearer reconnections until SSR.
++ *
++ * @param[in] apn_ip_type The APN type ("ipv4", "ipv6", or "ipv4v6").
++ */
++static bool should_disable_kpi_logging(const char* apn_ip_type) {
++    if (strncmp(apn_ip_type, "ipv4", 4) == 0) {
++        return (ip_received_status & IPv4BitMask);
++    } else if (strncmp(apn_ip_type, "ipv6", 4) == 0) {
++        return (ip_received_status & IPv6BitMask);
++    } else if (strncmp(apn_ip_type, "ipv4v6", 6) == 0) {
++        return (ip_received_status == (IPv4BitMask | IPv6BitMask));
++    }
++    return false;
++}
++
++/**
++ * @brief Find the access point with X_QCOM_ConnectBackHaul set to 1.
++ *
++ * Searches for an access point object where X_QCOM_ConnectBackHaul is 1.
++ *
++ * @param[in] dm The data model to search within.
++ *
++ * @return A pointer to the access point object if found, otherwise NULL.
++ */
++static amxd_object_t* find_connect_backhaul_ap(void) {
++    amxd_dm_t* dm = cellular_get_dm();
++    amxd_object_t* ap_root = amxd_dm_findf(dm, "Cellular.AccessPoint");
++    when_null_trace(ap_root, exit, ERROR, "Cellular.AccessPoint not found");
++
++    amxc_llist_for_each(it, (&ap_root->instances)) {
++        amxd_object_t* ap_obj = amxc_llist_it_get_data(it, amxd_object_t, it);
++        when_null_trace(ap_obj, exit, ERROR, "AccessPoint instance is null");
++        if (amxd_object_get_bool(ap_obj, "X_QCOM_ConnectBackHaul", NULL)) {
++            return ap_obj;
++        }
++    }
++
++exit:
++    return NULL;
++}
++
++/**
++ * @brief Get parameters from the access point object.
++ *
++ * Retrieves the APN type and profile ID from the access point object.
++ *
++ * @param[in]  ap_obj      The access point object.
++ * @param[out] apn_ip_type A pointer to store the APN type string.
++ * @param[out] profile_id  A pointer to store the profile ID.
++ *
++ * @return A boolean indicating success.
++ */
++static bool get_access_point_params(amxd_object_t* ap_obj, const char** apn_ip_type, int* profile_id) {
++    *apn_ip_type = amxd_object_get_cstring_t(ap_obj, "X_PRPLWARE-COM_IPType", NULL);
++    when_null_trace(*apn_ip_type, exit, ERROR, "Failed to get X_PRPLWARE-COM_IPType");
++
++    *profile_id = amxd_object_get_int32_t(ap_obj, "X_QCOM_ProfileId", NULL);
++    SAH_TRACEZ_INFO(ME, "Found AccessPoint with X_QCOM_ConnectBackHaul=1: %s, IPType=%s, ProfileId=%d",
++                    amxd_object_get_path(ap_obj, AMXD_OBJECT_INDEXED), *apn_ip_type, *profile_id);
++    return true;
++
++exit:
++    return false;
++}
++
++/**
++ * @brief Start timer for missing IP in ipv4v6 case.
++ *
++ * Starts a timer to handle delayed IPv4 or IPv6 assignment for ipv4v6 APN during bootup/SSR.
++ *
++ * @param[in] apn_ip_type   The APN type ("ipv4v6").
++ * @param[in] ip_wait_timer Pointer to the timer to start.
++ * @param[in] profile_id    The profile ID for KPI logging.
++ */
++static void start_ip_wait_timer(const char* apn_ip_type, int profile_id) {
++    if (strncmp(apn_ip_type, "ipv4v6", 6) != 0) return;
++
++    bool ipv4_missing = !(ip_received_status & IPv4BitMask);
++    bool ipv6_missing = !(ip_received_status & IPv6BitMask);
++
++    if (!ipv4_missing && !ipv6_missing) return;
++
++    timer_data_t* timer_data = malloc(sizeof(timer_data_t));
++    if (!timer_data) {
++        SAH_TRACEZ_ERROR(ME, "Failed to allocate timer data");
++        return;
++    }
++
++    timer_data->profile_id = profile_id;
++    timer_data->ipv4_type = ipv4_missing;
++
++    // Clean up existing timer
++    if (cellular.ip_wait_timer) {
++        amxp_timer_stop(cellular.ip_wait_timer);
++        amxp_timer_delete(&cellular.ip_wait_timer);
++    }
++
++    if (amxp_timer_new(&cellular.ip_wait_timer, ip_timeout_cb, timer_data) != 0) {
++        SAH_TRACEZ_ERROR(ME, "Failed to create timer");
++        free(timer_data);
++        return;
++    }
++
++    amxp_timer_start(cellular.ip_wait_timer, IP_WAIT_TIMER_MS);
++    SAH_TRACEZ_INFO(ME, "Created timer for %s address, profile %d",
++                    ipv4_missing ? "IPv4" : "IPv6", profile_id);
++}
++
++/**
++ * @brief Determine if KPI logging is required.
++ *
++ * This function checks if KPI logging should be performed based on the IP type
++ * and the specified APN IP type string.
++ *
++ * @param[in] ip_type     A boolean indicating whether the IP address is IPv4 or IPv6.
++ * @param[in] apn_ip_type The string representation of the APN type ("ipv4", "ipv6", "ipv4v6").
++ *
++ * @return A boolean indicating whether KPI logging is required.
++ */
++static bool should_log_kpi(const char* apn_ip_type, bool ipv4_type) {
++    if (strncmp(apn_ip_type, "ipv4", 4) == 0 && ipv4_type) return true;
++    if (strncmp(apn_ip_type, "ipv6", 4) == 0 && !ipv4_type) return true;
++    if (strncmp(apn_ip_type, "ipv4v6", 6) == 0) return true;
++    return false;
++}
++
++/**
++ * @brief Notify the cellular manager about IP address assignment.
++ *
++ * This function is called when an IP address is assigned in the IP Manager.
++ * Updates IP received status, logs KPIs only during bootup/SSR,
++ * and starts a timer for delayed IPs in ipv4v6 case.
++ *
++ * @param[in] obj  The object associated with the function call (unused).
++ * @param[in] func The function object (unused).
++ * @param[in] args The arguments passed to the function from IP Manager.
++ * @param[out] ret The return value of the function (unused).
++ *
++ * @return The status of the function call.
++ */
++amxd_status_t _NotifyIPAssigned(UNUSED amxd_object_t* obj, UNUSED amxd_function_t* func,
++                               amxc_var_t* args, UNUSED amxc_var_t* ret) {
++    SAH_TRACEZ_IN(ME);
++
++    amxd_status_t status = amxd_status_invalid_arg;
++    amxc_var_t data;
++    amxc_var_t result;
++
++    amxc_var_init(&result);
++    when_failed_trace(amxc_var_init(&data), exit, ERROR, "Failed to init data");
++
++    amxc_var_set_type(&data, AMXC_VAR_ID_HTABLE);
++
++    if (!is_kpi_logging_enabled) {
++        int ssr_kpi_flag = amxm_execute_function(MOD_QCMAP_CTRL, MOD_QCMAP_CTRL, "set-ssrkpi-flag", &data, &result);
++        if (ssr_kpi_flag != 0) {
++            SAH_TRACEZ_INFO(ME, "KPI logging disabled, skipping processing");
++            status = amxd_status_ok;
++            goto exit;
++        } else {
++            SAH_TRACEZ_INFO(ME, "SSR KPI Flag SET.");
++            reset_ssr_kpi_state();
++        }
++    }
++
++    bool ipv4_type = GET_BOOL(args, "IPv4Type");
++    amxd_object_t* ap_obj = find_connect_backhaul_ap();
++
++    if (!ap_obj) {
++        SAH_TRACEZ_ERROR(ME, "No AccessPoint with X_QCOM_ConnectBackHaul=1 found");
++        goto exit;
++    }
++
++    const char* apn_ip_type = NULL;
++    int profile_id = 0;
++
++    if (!get_access_point_params(ap_obj, &apn_ip_type, &profile_id)) {
++        goto exit;
++    }
++
++    // Update IP received status
++    ip_received_status |= ipv4_type ? IPv4BitMask : IPv6BitMask;
++    SAH_TRACEZ_INFO(ME, "IP received status: %d for %s",
++                    ip_received_status, ipv4_type ? "IPv4" : "IPv6");
++
++    // Log KPI if appropriate
++    if (should_log_kpi(apn_ip_type, ipv4_type)) {
++        log_ip_kpi(ipv4_type, profile_id);
++    }
++
++    // Start timer for missing IP in ipv4v6 case
++    start_ip_wait_timer(apn_ip_type, profile_id);
++
++    // Disable KPI logging if complete
++    if (should_disable_kpi_logging(apn_ip_type)) {
++        is_kpi_logging_enabled = false;
++        SAH_TRACEZ_INFO(ME, "All IPs received for %s, disabling KPI logging", apn_ip_type);
++    }
++
++    status = amxd_status_ok;
++
++exit:
++    SAH_TRACEZ_OUT(ME);
++    return status;
++}
+--
+2.34.1
+
