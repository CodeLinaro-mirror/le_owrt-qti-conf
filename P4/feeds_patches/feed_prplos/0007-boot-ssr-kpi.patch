+From: Sivapriya Seenivasan <sseeniva@qti.qualcomm.com>
+Date: Thu, 4 Sep 2025 16:41:18 +0530
+Subject: [PATCH] boot-ssr-kpi-libmm
+
+---
+ include_priv/mod_cellular-libmm.h |  3 +++
+ src/mod_cellular-libmm.c          | 45 +++++++++++++++++++++++++++++++
+ 2 files changed, 48 insertions(+)
+
+diff --git a/include_priv/mod_cellular-libmm.h b/include_priv/mod_cellular-libmm.h
+index 0cc6823..397e106 100644
+--- a/include_priv/mod_cellular-libmm.h
++++ b/include_priv/mod_cellular-libmm.h
+@@ -100,0 +101,3 @@ extern "C"
++#define BOOT_KPI_NODE "/sys/kernel/boot_kpi/kpi_values"
++#define MAX_COMMAND_STR_LEN             600
++
+diff --git a/src/mod_cellular-libmm.c b/src/mod_cellular-libmm.c
+index fd2615e..479e090 100644
+--- a/src/mod_cellular-libmm.c
++++ b/src/mod_cellular-libmm.c
+@@ -88,0 +89,5 @@
++static int g_KpiRecordFlag = 0;
++#define BootUP_Indication 0
++#define KPI_logged 1
++#define SSR_Indication 2
++
+@@ -1785,0 +1791,33 @@ libmm_get_state_reason_string (MMModemStateChangeReason reason) {
++/**
++ * @brief Update Modem In-Service KPI information.
++ *
++ * This function logs KPI information indicating that the modem is in service.
++ * The logging is performed only on `BootUP_Indication` or `SSR_Indication`.
++ *
++ * @return None
++ */
++static void update_modem_in_service_kpi(void) {
++    SAH_TRACEZ_IN(ME);
++
++    if (g_KpiRecordFlag == BootUP_Indication || g_KpiRecordFlag == SSR_Indication) {
++        FILE* kpi_file = fopen(BOOT_KPI_NODE, "a");
++        if (!kpi_file) {
++            SAH_TRACEZ_ERROR(ME, "Failed to open KPI file %s", BOOT_KPI_NODE);
++            return;
++        }
++
++        if (fprintf(kpi_file, "M - PRPL Modem in service") > 0) {
++            SAH_TRACEZ_INFO(ME, "Logged modem in service to %s", BOOT_KPI_NODE);
++            g_KpiRecordFlag = KPI_logged;
++        } else {
++            SAH_TRACEZ_ERROR(ME, "Failed to write KPI: M - PRPL Modem in service");
++        }
++
++        fclose(kpi_file);
++    } else {
++        SAH_TRACEZ_INFO(ME, "KPI already logged, skipping unless SSR reset");
++    }
++
++    SAH_TRACEZ_OUT(ME);
++}
++
+@@ -1802,0 +1841,6 @@ libmm_modem_state_changed (MMModem* modem,
++    //Log KPI for Modem-in-service
++    if (new_state == MM_MODEM_STATE_REGISTERED) {
++        SAH_TRACEZ_INFO(ME, "Modem %s is in REGISTERED state", modem_path);
++        update_modem_in_service_kpi();
++    }
++
+@@ -2253,0 +2298 @@ void libmm_handle_ssr_event(const char* status){
++        g_KpiRecordFlag = SSR_Indication;
+--
+2.34.1
+
