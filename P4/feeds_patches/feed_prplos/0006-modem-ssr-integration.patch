+             g_clear_error(&error);
+             cell_iface->bearer.connected = false;
+             mm_bearer_disconnect_sync(cell_iface->bearer_object, NULL, NULL);
+@@ -1917,8 +1955,9 @@ libmm_modem_added (UNUSED MMManager* manager,
+         g_clear_error(&error);
