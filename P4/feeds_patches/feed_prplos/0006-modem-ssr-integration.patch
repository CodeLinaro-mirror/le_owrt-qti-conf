++/*===========================================================================
++FUNCTION:  mod_hal_cellular_qcmap_event_handler
++===========================================================================*/
++/*!
++@brief
++Callback function invoked when the modem status changes. It logs the received status
++and then calls `libmm_handle_ssr` to process the modem's Subsystem Restart (SSR) event.
++
++@param
++status_ind - The current status of the modem (e.g., MODEM_STATUS_UP, MODEM_STATUS_DOWN).
++
++@return
++void
++*/
++/*=========================================================================*/
++static void mod_hal_cellular_qcmap_event_handler(modem_status_t status_ind) {
++    SAH_TRACEZ_INFO(ME,"Received modem status indication (via callback): %d",status_ind);
++
++    const char* modem_status;
++    modem_status = (status_ind == 0) ? "MODEM_STATUS_UP" :
++                   (status_ind == 1) ? "MODEM_STATUS_DOWN" :
++                                       "MODEM_STATUS_UNKNOWN"; // Default for unexpected values
++
++    // Log if an unknown status was encountered
++    if (strncmp(modem_status, "MODEM_STATUS_UNKNOWN", strlen("MODEM_STATUS_UNKNOWN")) == 0) {
++        SAH_TRACEZ_ERROR(ME, "Received unknown modem status indication: %d, passing as UNKNOWN", status_ind);
++    }
++    SAH_TRACEZ_INFO(ME, "Passing string to libmm_handle_ssr: %s", modem_status);
++    libmm_handle_ssr_event(modem_status);
++}
++
++/*===========================================================================
++FUNCTION:  modem_ind_register
++===========================================================================*/
++/*!
++@brief
++Initializes the modem indication retrieval process. This function registers for modem
++status indications and sets up a callback to handle these indications, typically related
++to Subsystem Restart (SSR) events.
++
++@param
++function_name - Unused parameter.
++@param
++args - Arguments passed to the function (expected to be non-NULL).
++@param
++ret - Unused parameter for return value.
++
++@return
++int - 0 on success, or an error code if registration or callback setup fails.
++*/
++/*=========================================================================*/
++int modem_ind_register(UNUSED const char* function_name,
++                       amxc_var_t* args,
++                       UNUSED amxc_var_t* ret) {
++
++    SAH_TRACEZ_IN(ME);
++    SAH_TRACEZ_INFO(ME, "Entering function modem_ind_register");
++
++    int rv = -1;
++    when_null_trace(args, exit, ERROR, "No arguments provided");
++
++    rv = cellular_hal_qcmap_client_init();
++    when_failed_trace(rv, exit, ERROR, "Registration of MODEM_STATUS_IND failed");
++
++    cellular_hal_qcmap_register_ssr_event_callback(mod_hal_cellular_qcmap_event_handler);
++    SAH_TRACEZ_INFO(ME, "Registration of MODEM_STATUS_IND done!, rv=%d", rv);
++    rv = 0;
++exit:
++    SAH_TRACEZ_INFO(ME, "End of function modem_ind_register");
++    SAH_TRACEZ_OUT(ME);
++    return rv;
++}
++
