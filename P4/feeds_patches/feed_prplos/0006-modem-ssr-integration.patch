++/**
++* @brief Periodically poll for the availability of modem ID.
++*
++* This function is designed to be called repeatedly (e.g., as a GSource callback
++* or similar polling mechanism) to check for the presence and availability
++* of modem ID.
++*
++* @param[in] user_data (unused in this specific signature).
++*
++* @return G_SOURCE_CONTINUE if polling should continue (modem ID not yet found
++*         or process still ongoing), G_SOURCE_REMOVE if the modem ID has been
++*         successfully found and polling should stop.
++*/
++static gboolean poll_for_modem_id(UNUSED gpointer user_data) {
++    GList* modems;
+
+-error:
+-    if(libmm_manager != NULL) {
+-        g_signal_handlers_disconnect_by_func(libmm_manager, G_CALLBACK(libmm_modem_added), NULL);
+-        g_signal_handlers_disconnect_by_func(libmm_manager, G_CALLBACK(libmm_modem_removed), NULL);
+-        g_object_unref(libmm_manager);
+-        libmm_manager = NULL;
++    /* Check if ModemManager instance is valid; if not, stop polling */
++    if (!libmm_manager) {
++       SAH_TRACEZ_INFO(ME,"ModemManager instance is NULL during polling. Stopping polling.");
++       modem_polling_source_id = 0;
++       return G_SOURCE_REMOVE;
+     }
+
+-    /* Reset all interfaces operational status */
+-    amxc_llist_for_each(it, libmm_cell_ifaces) {
+-        cell_iface = amxc_container_of(it, libmm_cell_iface_t, it);
+-
+-        detach_modem_from_cell_iface(cell_iface);
++    /* Get list of objects (modems) from ModemManager D-Bus manager */
++    modems = g_dbus_object_manager_get_objects(G_DBUS_OBJECT_MANAGER(libmm_manager));
+
+-        /* Instruct cellular manager to update Cellular.Interface object state */
+-        libmm_dm_read_interface_last_change(cell_iface);
++    if (modems != NULL) {
++       SAH_TRACEZ_INFO(ME,"Polling finished, Modem found!");
++       modem_polling_source_id = 0;
++       return G_SOURCE_REMOVE;
++    } else {
++       SAH_TRACEZ_INFO(ME,"No modems found yet");
+     }
+
+-    g_mutex_unlock(&libmm_lock);
+-
+-    /* Reattempt to get the pointer to MManager object */
+-    libmm_get_manager(task);
+-
+-    return G_SOURCE_REMOVE;
++    /* Continue polling in the next iteration */
++    return G_SOURCE_CONTINUE;
+ }
+
+ static GList*
