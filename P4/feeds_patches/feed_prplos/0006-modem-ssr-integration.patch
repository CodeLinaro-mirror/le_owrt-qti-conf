++/**
++* @brief Callback function triggered when ModemManager appears on D-Bus.
++*
++* This function is invoked when a new ModemManager instance (identified by its bus name)
++* appears on the system D-Bus. It typically indicates that the ModemManager service
++* has started or reconnected.
++*
++* @param[in] connection The GDBusConnection instance (unused).
++* @param[in] name The unique bus name of the appearing ModemManager service.
++* @param[in] name_owner The unique name of the owner of the bus name.
++* @param[in] user_data User-defined data passed to the callback (unused).
++*
++* @return void
++*/
++static void on_modem_manager_appeared(UNUSED GDBusConnection *connection,
++                                      const gchar     *name,
++                                      const gchar     *name_owner,
++                                      UNUSED gpointer  user_data) {
++    SAH_TRACEZ_INFO(ME,"D-Bus Watcher: ModemManager service '%s' appeared with owner '%s'", name, name_owner);
++
++    /* Trigger a continuous attempt of polling for every 1sec for getting modem ID */
++    SAH_TRACEZ_INFO(ME,"Starting continuous polling for modem ID every %d ms", POLL_INTERVAL_MS);
++    modem_polling_source_id = g_timeout_add(POLL_INTERVAL_MS * 1000, (GSourceFunc) poll_for_modem_id, libmm_manager);
++}
++
++/**
++* @brief Checks the active status of the ModemManager service.
++*
++* This function queries the system to determine if the ModemManager service
++* is currently running and active.
++*
++* @return 0 if ModemManager is active and running, -1 otherwise (e.g., not active,
++*         error checking status).
++*/
++static int check_mm_active_status(void) {
++    SAH_TRACEZ_INFO(ME, "Entering MM active status");
++    FILE *fp;
++    char runningStatus[16];
++    int retVal = -1;
++
++        for(int i = 0; i <= MM_STATUS_CHECK_RETRY_COUNT; i++) {
++        /* Read the output of the command into the 'runningStatus' buffer */
++        fp = popen(MODEM_ACTIVE_STATUS_GET_CMD, "r");
++        if (fp == NULL) {
++            SAH_TRACEZ_ERROR(ME, "Failed to read modem status");
++            continue; // Try again in the next iteration
++        }
++        /* Check if the output indicates the modem manager is "running" */
++        if(fgets(runningStatus, sizeof(runningStatus), fp) != NULL) {
++            if (strstr(runningStatus, "running") != NULL) {
++                retVal = 0;
++                pclose(fp);
++                break;
++            }
++            /* Check if the output indicates the modem manager is "inactive" */
++            else if (strstr(runningStatus, "inactive") != NULL) {
++                retVal = -1;
++                pclose(fp);
++                break;
++            }
++            else {
++                pclose(fp);
++                sleep(MM_STATUS_CHECK_TIMEOUT);
++            }
++        } else {
++            pclose(fp);
++        }
++    }
++    return retVal;
++}
++
++/**
++* @brief Handles the System Subsystem Restart (SSR) event for the ModemManager library.
++*
++* This function is invoked when a System Subsystem Restart (SSR) event occurs,
++* indicating a restart or critical failure of a core system component.
++*
++* @param[in] status A string indicating MODEM_STATUS_DOWN/MODEM_STATUS_UP
++*
++* @return void
++*/
++void libmm_handle_ssr_event(const char* status){
++    SAH_TRACEZ_INFO(ME,"Entering handle_ssr for status: %s", status);
++
++    if (0 == strncmp(status,"MODEM_STATUS_DOWN", strlen("MODEM_STATUS_DOWN"))) {
++        SAH_TRACEZ_INFO(ME,"Out-of-Service Indication detected");
++        /* Unwatch MM D-Bus on SSR */
++        g_bus_unwatch_name(mm_watch_id);
++        mm_watch_id = 0;
++
++        /* MM service successfully stopped and its inactive status confirmed */
++        int cmd_result = system(MM_STOP_CMD);
++        if (cmd_result == -1) {
++            SAH_TRACEZ_ERROR(ME, "Failed to execute command to stop ModemManager");
++        } else if (WEXITSTATUS(cmd_result) != 0) {
++            SAH_TRACEZ_ERROR(ME, "Command to stop ModemManager failed with exit code %d", WEXITSTATUS(cmd_result));
++        } else if (0 != check_mm_active_status()) {
++            SAH_TRACEZ_INFO(ME, "Stopped Modem Manager due to Modem Out of Service Event");
++            mm_service_active = false;
++        }
++    } else if ((0 == strncmp(status,"MODEM_STATUS_UP", strlen("MODEM_STATUS_UP"))) && (mm_service_active == false)) {
++        SAH_TRACEZ_INFO(ME,"In-Service Indication detected.");
++
++        /* Start MM D-Bus object watch */
++        mm_watch_id = g_bus_watch_name(G_BUS_TYPE_SYSTEM,
++                                       "org.freedesktop.ModemManager1",
++                                       G_BUS_NAME_WATCHER_FLAGS_NONE,
++                                       on_modem_manager_appeared,
++                                       NULL,
++                                       NULL,
++                                       NULL);
++
++        /* MM service successfully started and its active status confirmed */
++		int cmd_result = system(MM_START_CMD);
++		if (cmd_result == -1) {
++		    SAH_TRACEZ_ERROR(ME, "Failed to execute command to start ModemManager");
++		} else if (WEXITSTATUS(cmd_result) != 0) {
++		    SAH_TRACEZ_ERROR(ME, "Command to start ModemManager Service failed with exit code %d", WEXITSTATUS(cmd_result));
++		} else if (0 == check_mm_active_status()) {
++		    SAH_TRACEZ_INFO(ME, "Started Modem Manager after Modem In Service Event");
++            mm_service_active = true;
++	    }
++    } else if ((0 == strncmp(status,"MODEM_STATUS_UP", strlen("MODEM_STATUS_UP"))) && (mm_service_active == true)) {
++        SAH_TRACEZ_INFO(ME,"IN Indication at boot received.");
++    }
++    SAH_TRACEZ_INFO(ME,"Exiting handle_ssr");
++}
++
+ static AMXM_CONSTRUCTOR libmm_module_start(void) {
+     int retval = -1;
+     amxm_shared_object_t* so = amxm_so_get_current();
+--
