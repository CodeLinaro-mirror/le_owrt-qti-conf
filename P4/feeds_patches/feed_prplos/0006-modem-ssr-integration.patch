++static AMXM_CONSTRUCTOR qcmap_module_start(void) {
++    SAH_TRACEZ_IN(ME);
++    SAH_TRACEZ_INFO(ME, "Entering qcmap_module_start function ");
++
++    int ret = 0;
++    amxm_shared_object_t* so = amxm_so_get_current();
++    amxm_module_t* mod = NULL;
++
++    if (!so) {
++        SAH_TRACEZ_ERROR(ME, "Failed to get current shared object");
++        return -1;
++    }
++    SAH_TRACEZ_INFO(ME, "Successfully got shared object");
++    ret = amxm_module_register(&mod, so, MOD_QCMAP_CTRL);
