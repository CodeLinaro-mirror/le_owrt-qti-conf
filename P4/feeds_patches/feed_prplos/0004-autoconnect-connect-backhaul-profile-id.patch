+From 48c8fe8cdf25dffc272590c664b0c8ee6d4e5ec3 Mon Sep 17 00:00:00 2001
+From: Krishnapriya Kunhikannan <kkunhika@qti.qualcomm.com>
+Date: Thu, 28 Aug 2025 12:54:17 +0530
+Subject: [PATCH] Profile ID and ConnectBackHaul
+
+---
+ include_priv/mod_cellular-libmm.h |   5 +
+ src/mod_cellular-libmm.c          | 244 +++++++++++++++++++++++++++++-
+ 2 files changed, 246 insertions(+), 3 deletions(-)
+
+diff --git a/include_priv/mod_cellular-libmm.h b/include_priv/mod_cellular-libmm.h
+index 117e60f..9702233 100644
+--- a/include_priv/mod_cellular-libmm.h
++++ b/include_priv/mod_cellular-libmm.h
+@@ -150,0 +151 @@ typedef struct _cell_libmm_iface {
++    bool auto_connect;
+@@ -188,0 +190,4 @@ int libmm_bearer_retrieve(const char* function_name,
++int libmm_iface_get_profile_id(UNUSED const char* function_name,
++                           amxc_var_t* args,
++                           amxc_var_t* ret);
++
+diff --git a/src/mod_cellular-libmm.c b/src/mod_cellular-libmm.c
+index 75c34db..07c63f4 100644
+--- a/src/mod_cellular-libmm.c
++++ b/src/mod_cellular-libmm.c
+@@ -97,0 +98,2 @@ static void reset_libmm_cell_bearer(libmm_cell_bearer_t* bearer);
++static gint get_profile_id_matching_apn(MMObject *modem_object, const char *apn, GError **error);
++
+@@ -1297,0 +1300,4 @@ int libmm_iface_set(UNUSED const char* function_name,
++    gint profile_id = -1;
++    bool connect_backhaul = false;
++    bool auto_connect = false;
++    const char* apn = NULL;
+@@ -1304,0 +1311 @@ int libmm_iface_set(UNUSED const char* function_name,
++    apn = GET_CHAR(args, "APN");
+@@ -1316,0 +1324,23 @@ int libmm_iface_set(UNUSED const char* function_name,
++    // Get profile_id from args
++    if (GET_ARG(args, "ProfileID")) {
++        profile_id = GET_INT32(args, "ProfileID");
++        //To retrieve profile ID if not retrieved early.
++        if (profile_id <= 0) {
++            profile_id = get_profile_id_matching_apn(cell_iface->modem_object, apn, &error);
++        }
++        SAH_TRACEZ_INFO(ME, "Using provided Profile ID: %d", profile_id);
++    }
++
++    // Get AutoConnect value from args
++    if (GET_ARG(args, "AutoConnect")) {
++        auto_connect = GET_BOOL(args, "AutoConnect");
++        cell_iface->auto_connect = auto_connect;
++        SAH_TRACEZ_INFO(ME, "Using provided AutoConnect: %d", auto_connect);
++    }
++
++    /* Get ConnectBackHaul from args, default to false if not present */
++    if (GET_ARG(args, "ConnectBackHaul")) {
++        connect_backhaul = GET_BOOL(args, "ConnectBackHaul");
++        SAH_TRACEZ_INFO(ME, "Using provided ConnectBackHaul: %d", connect_backhaul);
++    }
++
+@@ -1321 +1351 @@ int libmm_iface_set(UNUSED const char* function_name,
+-        if(cell_iface->enable && !prev_enable) {
++        if(cell_iface->enable && connect_backhaul) {
+@@ -1342,0 +1373,7 @@ int libmm_iface_set(UNUSED const char* function_name,
++                //Initiate call with valid profile ID
++                if (profile_id <= 0) {
++                    SAH_TRACEZ_ERROR(ME, "Profile ID is not retrieved, not establising the connection");
++                    goto exit;
++                }
++                mm_bearer_properties_set_profile_id(cell_iface->bearer_properties, profile_id);
++                SAH_TRACEZ_INFO(ME, "Set Profile ID: %d for interface: %s", profile_id, cell_iface->name);
+@@ -1350,0 +1388,6 @@ int libmm_iface_set(UNUSED const char* function_name,
++        } else if(cell_iface->enable && !connect_backhaul) {
++            if(modem) {
++                SAH_TRACEZ_NOTICE(ME, "Disconnecting interface: %s", cell_iface->name);
++                run_result = mm_modem_run_sync(modem, cell_iface, FALSE);
++                strlcpy(cell_iface->status, run_result ? "Down" : "Error", sizeof(cell_iface->status));
++            }
+@@ -1731,2 +1774,6 @@ libmm_modem_state_changed (MMModem* modem,
+-    when_true((old_state != MM_MODEM_STATE_CONNECTING && old_state != MM_MODEM_STATE_CONNECTED) ||
+-              (new_state != MM_MODEM_STATE_DISCONNECTING && new_state != MM_MODEM_STATE_ENABLED), exit);
++    /* Exit early if any condition fails: state transition is not from
++     * DISCONNECT to REGISTERED, auto-connect disabled, or no bearer object */
++    when_true((old_state != MM_MODEM_STATE_DISCONNECTING) ||
++          (new_state != MM_MODEM_STATE_REGISTERED) ||
++          (!cell_iface->auto_connect) ||
++          (cell_iface->bearer_object == NULL), exit);
+@@ -1915,0 +1963,190 @@ exit:
++/**
++* @brief Enable a modem if it is in the disabled state.
++*
++* This function checks the modem state and enables it if it is disabled.
++*
++* @param[in] modem_object The modem object.
++* @param[out] error A pointer to a GError to store any error that occurs.
++*
++* @return TRUE if the modem is enabled or was already enabled, FALSE otherwise.
++*/
++static gboolean libmm_modem_enable(MMObject *modem_object, GError **error) {
++    MMModem *modem = NULL;
++    MMModemState modem_state;
++    const gchar *modem_path;
++    gboolean result = FALSE;
++
++    when_null_trace(modem_object, exit, ERROR, "Modem object is NULL");
++
++    modem_path = mm_object_get_path(modem_object);
++    SAH_TRACEZ_INFO(ME, "Checking modem state for %s", modem_path);
++
++    modem = mm_object_get_modem(modem_object);
++    when_null_trace(modem, exit, ERROR, "Failed to get modem from object %s", modem_path);
++
++    modem_state = mm_modem_get_state(modem);
++    if (modem_state == MM_MODEM_STATE_DISABLED) {
++        if (!mm_modem_enable_sync(modem, NULL, error)) {
++            SAH_TRACEZ_ERROR(ME, "Failed to enable modem %s: %s", modem_path, (*error)->message);
++            goto exit;
++        }
++        SAH_TRACEZ_INFO(ME, "Modem %s enabled successfully", modem_path);
++    }
++
++    result = TRUE;
++
++exit:
++    g_clear_object(&modem);
++    return result;
++}
++
++/**
++ * @brief Get the profile ID matching a given APN from the modem.
++ *
++ * This function searches for a profile with a matching APN in the modem's profile manager.
++ *
++ * @param[in] modem_object The modem object.
++ * @param[in] apn The APN to match.
++ * @param[in] modem_path The path of the modem.
++ * @param[out] error A pointer to a GError to store any error that occurs.
++ *
++ * @return The profile ID if found, otherwise -1.
++ */
++static gint get_matching_profile_from_apn(MMObject *modem_object, const char *apn, const char *modem_path, GError **error)
++{
++    GList *profiles = NULL;
++    GList *l;
++    gint profile_id = -1;
++    MMModem3gppProfileManager *profile_manager = NULL;
++
++    /* Get profile manager */
++    profile_manager = mm_object_get_modem_3gpp_profile_manager(modem_object);
++    when_null_trace(profile_manager, exit, ERROR, "Profile manager not found for modem %s", modem_path);
++
++    /* List profiles */
++    if (!mm_modem_3gpp_profile_manager_list_sync(profile_manager, NULL, &profiles, error)) {
++        SAH_TRACEZ_ERROR(ME, "Failed to list profiles for modem %s: %s", modem_path, (*error)->message);
++        goto exit;
++    }
++
++    /* Search for profile with matching APN */
++    for (l = profiles; l; l = g_list_next(l)) {
++        MM3gppProfile *profile = MM_3GPP_PROFILE(l->data);
++        const gchar *profile_apn = mm_3gpp_profile_get_apn(profile);
++        if (profile_apn && g_str_equal(profile_apn, apn)) {
++            profile_id = mm_3gpp_profile_get_profile_id(profile);
++            SAH_TRACEZ_INFO(ME, "Found APN: %s with Profile ID: %d", apn, profile_id);
++            break;
++        }
++    }
++
++    if (profile_id == -1) {
++        SAH_TRACEZ_ERROR(ME, "No profile found with APN %s on modem %s", apn, modem_path);
++    }
++
++exit:
++    g_list_free_full(profiles, g_object_unref);
++    g_clear_object(&profile_manager);
++    return profile_id;
++}
++
++/**
++ * @brief Get the profile ID matching a given APN for a modem.
++ *
++ * This function checks the modem state and searches for a profile with a matching APN.
++ * If the modem is disabled, it attempts to enable it before searching for the profile.
++ *
++ * @param[in] modem_object The modem object.
++ * @param[in] apn The APN to match.
++ * @param[out] error A pointer to a GError to store any error that occurs.
++ *
++ * @return The profile ID if found, otherwise -1.
++ */
++static gint get_profile_id_matching_apn(MMObject *modem_object, const char *apn, GError **error) {
++    MMModem *modem = NULL;
++    const gchar *modem_path;
++    gint profile_id = -1;
++
++    when_null_trace(modem_object, exit, ERROR, "Modem object is NULL");
++    when_null_trace(apn, exit, ERROR, "APN is NULL");
++
++    modem_path = mm_object_get_path(modem_object);
++    SAH_TRACEZ_INFO(ME, "Searching for profile with APN %s on modem %s", apn, modem_path);
++
++    /* Get modem */
++    modem = mm_object_get_modem(modem_object);
++    when_null_trace(modem, exit, ERROR, "Failed to get modem from object %s", modem_path);
++
++    if (!libmm_modem_enable(modem_object, error)) {
++        goto exit;
++    }
++
++    /* Search for profile with matching APN */
++    profile_id = get_matching_profile_from_apn(modem_object, apn, modem_path, error);
++
++exit:
++    g_clear_object(&modem);
++    return profile_id;
++}
++
++/**
++ * @brief Retrieve the profile ID for a given APN on a cellular interface.
++ *
++ * This function retrieves the profile ID for a specified APN on a cellular interface.
++ * It uses the modem object associated with the interface to search for the profile.
++ *
++ * @param[in] function_name The name of the function (unused).
++ * @param[in] args The arguments passed to the function, containing the object path and APN.
++ * @param[out] ret The return value of the function, containing the profile ID.
++ *
++ * @return 0 on success, -1 on failure.
++ */
++int libmm_iface_get_profile_id(UNUSED const char* function_name,
++                           amxc_var_t* args,
++                           amxc_var_t* ret) {
++    int retval = -1;
++    const char* obj_path = NULL;
++    const char* apn = NULL;
++    libmm_cell_iface_t* cell_iface = NULL;
++    GError* error = NULL;
++    gint profile_id = -1;
++
++    g_mutex_lock(&libmm_lock);
++
++    when_null_trace(args, exit, ERROR, "Passed args is NULL");
++    when_null_trace(ret, exit, ERROR, "Passed ret is NULL");
++    when_failed_trace((amxc_var_type_of(args) != AMXC_VAR_ID_HTABLE), exit, ERROR,
++                      "args is not an htable");
++
++    obj_path = GET_CHAR(args, "ObjectPath");
++    when_null_trace(obj_path, exit, ERROR, "Passed object path is NULL");
++    apn = GET_CHAR(args, "APN");
++    when_null_trace(apn, exit, ERROR, "Passed APN is NULL");
++
++    cell_iface = find_libmm_cell_iface_by_object_path(obj_path);
++    when_null_trace(cell_iface, exit, ERROR, "libmm cell interface %s not found", obj_path);
++
++    SAH_TRACEZ_INFO(ME, "Retrieving profile ID for interface %s with APN %s", obj_path, apn);
++
++    if (!cell_iface->modem_object) {
++        SAH_TRACEZ_ERROR(ME, "No modem object associated with interface %s", obj_path);
++        goto exit;
++    }
++
++    profile_id = get_profile_id_matching_apn(cell_iface->modem_object, apn, &error);
++    if (profile_id <= 0) {
++        SAH_TRACEZ_ERROR(ME, "Failed to find profile ID for APN %s: %s", apn, error ? error->message : "profile not found");
++        goto exit;
++    }
++
++    amxc_var_set_type(ret, AMXC_VAR_ID_HTABLE);
++    amxc_var_add_key(int32_t, ret, "ProfileID", profile_id);
++    retval = 0;
++    SAH_TRACEZ_INFO(ME, "Profile ID %d retrieved for APN %s", profile_id, apn);
++
++exit:
++    g_clear_error(&error);
++    g_mutex_unlock(&libmm_lock);
++    return retval;
++}
++
+@@ -1934,0 +2172 @@ static AMXM_CONSTRUCTOR libmm_module_start(void) {
++    amxm_module_add_function(mod, "get-profile-id", libmm_iface_get_profile_id);
+-- 
+2.34.1
+
diff --git a/net_core/plugins/cellular-manager/patches/0002-autoconnect-default-profile-connect-backhaul.patch b/net_core/plugins/cellular-manager/patches/0002-autoconnect-default-profile-connect-backhaul.patch
new file mode 100644
index 0000000..fd232fe
--- /dev/null
+++ b/net_core/plugins/cellular-manager/patches/0002-autoconnect-default-profile-connect-backhaul.patch
@@ -0,0 +1,631 @@
+This patch file is from Qualcomm Technologies, Inc. and
+is provided under the following license:
