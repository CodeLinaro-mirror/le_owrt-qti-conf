+From 45adbf21d67227f553d6ae0b0a89ed291a8e8baf Mon Sep 17 00:00:00 2001
+From: Krishnapriya Kunhikannan <kkunhika@qti.qualcomm.com>
+Date: Thu, 21 Aug 2025 06:42:55 +0530
+Subject: [PATCH] autoconnect-default-profile-connect-backhaul
+
+---
+ include_priv/cellular_events.h      |   8 +
+ include_priv/cellular_soc_utils.h   |   2 +-
+ odl/cellular-manager_definition.odl |  35 ++++
+ src/cellular_soc_utils.c            |  53 +++++-
+ src/cellular_utils.c                | 140 ++++++++++++++-
+ src/dm_cellular_events.c            | 256 ++++++++++++++++++++++++++++
+ 6 files changed, 490 insertions(+), 4 deletions(-)
+
+diff --git a/include_priv/cellular_events.h b/include_priv/cellular_events.h
+index 1b670fa..9222c09 100644
+--- a/include_priv/cellular_events.h
++++ b/include_priv/cellular_events.h
+@@ -92,6 +92,14 @@ void _print_event(const char* const sig_name,
+                   const amxc_var_t* const data,
+                   void* const priv);
+ 
++void _access_point_connect_backhaul_changed(UNUSED const char* const sig_name,
++                                           const amxc_var_t* const data,
++                                           UNUSED void* const priv);
++
++void _access_point_default_profile_changed(UNUSED const char* const sig_name,
++                                          const amxc_var_t* const data,
++                                          UNUSED void* const priv);
++
+ #ifdef __cplusplus
+ }
+ #endif
+diff --git a/include_priv/cellular_soc_utils.h b/include_priv/cellular_soc_utils.h
+index 569f868..9cdacd0 100644
+--- a/include_priv/cellular_soc_utils.h
++++ b/include_priv/cellular_soc_utils.h
+@@ -72,7 +72,7 @@ int mod_cellular_execute_function(amxd_object_t* cellular_obj, const char* funct
+ 
+ int mod_cellular_set_interface_params(amxd_object_t* cellular_obj);
+ 
+-int set_cell_iface_enabled(cell_iface_t* cell_iface, bool enable);
++int set_cell_iface_enabled(cell_iface_t* cell_iface, bool enable, bool connect_backhaul, amxd_object_t* ap_obj);
+ int set_cell_iface_usim(cell_iface_t* cell_iface, const char* pincheck, const char* pin);
+ 
+ void cell_iface_fill_trans(cell_iface_t* cell_iface, amxd_trans_t* trans);
+diff --git a/odl/cellular-manager_definition.odl b/odl/cellular-manager_definition.odl
+index 5b32472..b33ae58 100644
+--- a/odl/cellular-manager_definition.odl
++++ b/odl/cellular-manager_definition.odl
+@@ -26,6 +26,15 @@
+             on action validate call check_is_empty_or_in "Cellular.SupportedControllers";
+         }
+ 
++        /**
++         * Enables or disables automatic connection on bootup.
++         * If TRUE, the connection cannot be brought down manually.
++         * Default is FALSE.
++         *
++         * @version V1.1
++         */
++        %persistent bool X_QCOM_AutoConnect = false;
++
+         /**
+          * Enables or disables the roaming.
+          *
+@@ -582,6 +591,28 @@
+             %persistent uint32 ProxyPort {
+                 on action validate call check_range [0, 65535];
+             }
++	     /**
++	     * Controls the connection state of this Access Point.
++	     * If TRUE, establishes the connection; if FALSE, disconnects it.
++	     * Not exposed to TR-069 (internal use only). Not a persistent value.
++	     *
++	     * @version V1.1
++	     */
++	    bool X_QCOM_ConnectBackHaul = false;
++	    /**
++	     * Indicates if this Access Point is the default profile for automatic connection.
++	     * Only one instance can be TRUE at a time.
++	     *
++	     * @version V1.1
++	     */
++	    %persistent bool X_QCOM_DefaultProfile = false;
++	    /**
++	     * Read-only identifier of the profile used for the connection.
++	     * Maps to the profile ID maintained in MM for the corresponding APN.
++	     *
++	     * @version V1.1
++	     */
++	    %read-only uint32 X_QCOM_ProfileId;
+ 
+             /**
+              * The value MUST be the Path Name of a row in the Interface table.
+@@ -621,6 +652,10 @@
+         filter 'path == "Cellular.AccessPoint."';
+     on event "dm:object-changed" call cell_ap_enable_changed
+         filter 'path matches "Cellular\.AccessPoint\.[0-9]+\.$" && contains("parameters.Enable")';
++    on event "dm:object-changed" call access_point_connect_backhaul_changed
++        filter 'path matches "Cellular\.AccessPoint\.[0-9]+\.$" && contains("parameters.X_QCOM_ConnectBackHaul")';
++    on event "dm:object-changed" call access_point_default_profile_changed
++        filter 'path matches "Cellular\.AccessPoint\.[0-9]+\.$" && contains("parameters.X_QCOM_DefaultProfile")';
+     // uncomment for debugging (only logs to syslog)
+     // on event "*" call print_event
+     //    filter 'path matches "Cellular\..*"';
+diff --git a/src/cellular_soc_utils.c b/src/cellular_soc_utils.c
+index c66a2cb..b87cb70 100644
+--- a/src/cellular_soc_utils.c
++++ b/src/cellular_soc_utils.c
+@@ -306,10 +306,14 @@ exit:
+     return rv;
+ }
+ 
+-int set_cell_iface_enabled(cell_iface_t* cell_iface, bool enable) {
++int set_cell_iface_enabled(cell_iface_t* cell_iface, bool enable, bool connect_backhaul, amxd_object_t* ap_obj) {
+     int rv = -1;
+     amxc_var_t data;
+     amxc_var_t ret;
++    int32_t profile_id = -1;
++
++    SAH_TRACEZ_INFO(ME, "Entering set_cell_iface_enabled, enable=%d, connect_backhaul=%d",
++                    enable, connect_backhaul);
+ 
+     when_failed_trace(amxc_var_init(&ret), exit, ERROR, "Failed to init ret");
+     when_failed_trace(amxc_var_init(&data), exit, ERROR, "Failed to init data");
+@@ -322,13 +326,15 @@ int set_cell_iface_enabled(cell_iface_t* cell_iface, bool enable) {
+     amxc_var_set_type(&data, AMXC_VAR_ID_HTABLE);
+     amxc_var_add_key(cstring_t, &data, "ObjectPath", amxd_object_get_path(cell_iface->object, AMXD_OBJECT_INDEXED));
+     amxc_var_add_key(bool, &data, "Enable", enable);
++    amxc_var_add_key(bool, &data, "ConnectBackHaul", connect_backhaul);
+ 
+     amxd_dm_t* dm = cellular_get_dm();
++    when_null_trace(dm, exit, ERROR, "Failed to get data model");
+     amxd_object_t* cell_obj = amxd_dm_findf(dm, "Cellular");
+     when_null_trace(cell_obj, exit, ERROR, "Cellular not found");
+     const amxc_var_t* roaming = amxd_object_get_param_value(cell_obj, "RoamingEnabled");
+-    amxd_object_t* ap_obj = find_accesspoint_obj(amxd_object_get_index(cell_iface->object));
+     when_null_trace(ap_obj, exit, ERROR, "AccessPoint not found");
++    const amxc_var_t* auto_connect = amxd_object_get_param_value(cell_obj, "X_QCOM_AutoConnect");
+     const amxc_var_t* apn = amxd_object_get_param_value(ap_obj, "APN");
+     const amxc_var_t* user = amxd_object_get_param_value(ap_obj, "Username");
+     const amxc_var_t* pass = amxd_object_get_param_value(ap_obj, "Password");
+@@ -344,12 +350,55 @@ int set_cell_iface_enabled(cell_iface_t* cell_iface, bool enable) {
+ 
+     amxc_var_add_key(cstring_t, &data, "APN", amxc_var_constcast(cstring_t, apn));
+     amxc_var_add_key(bool, &data, "RoamingEnabled", amxc_var_dyncast(bool, roaming));
++    amxc_var_add_key(bool, &data, "AutoConnect", amxc_var_dyncast(bool, auto_connect));
+     amxc_var_add_key(cstring_t, &data, "UserName", amxc_var_constcast(cstring_t, user));
+     amxc_var_add_key(cstring_t, &data, "Password", amxc_var_constcast(cstring_t, pass));
+     amxc_var_add_key(cstring_t, &data, "Proxy", amxc_var_constcast(cstring_t, proxy));
+     amxc_var_add_key(uint32_t, &data, "ProxyPort", amxc_var_dyncast(uint32_t, port));
+     amxc_var_add_key(cstring_t, &data, "IPType", amxc_var_constcast(cstring_t, iptype));
+ 
++    // Retrieve ProfileID if the interface is enabled
++    if (!enable) {
++        SAH_TRACEZ_WARNING(ME, "Interface is not Enabled, so not retrieving the Profile ID");
++        goto set_cell_iface_info;
++    }
++
++    amxc_var_t profile_data;
++    when_failed_trace(amxc_var_init(&profile_data), exit, ERROR, "Failed to init profile_data");
