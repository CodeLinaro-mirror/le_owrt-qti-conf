++/**
++ * @brief Updates a flag on a NetModel interface.
++ *
++ * This function sets or clears a flag on a specified NetModel interface.
++ *
++ * @param[in] netmodel_intf  The name of the NetModel interface to update.
++ * @param[in] flag           The name of the flag to set or clear.
++ * @param[in] set            A boolean indicating whether to set (true) or clear (false) the flag.
++ *
++ * @return None
++ */
++static void update_flag(const char* netmodel_intf, const char* flag, bool set) {
++    amxc_var_t args;
++    amxc_var_t ret;
++    const char* function = set ? "setFlag" : "clearFlag";
++
++    amxc_var_init(&args);
++    amxc_var_init(&ret);
++
++    amxc_var_set_type(&args, AMXC_VAR_ID_HTABLE);
++    amxc_var_add_key(cstring_t, &args, "flag", flag);
++
++    if(AMXB_STATUS_OK != amxb_call(netmodel_get_amxb_bus(), netmodel_intf, function, &args, &ret, 5)) {
++        SAH_TRACEZ_ERROR(ME, "Failed to call %s%s(flag='%s')", netmodel_intf, function, flag);
++        goto exit;
++    }
++
++exit:
++    amxc_var_clean(&args);
++    amxc_var_clean(&ret);
++}
++/**
++ * @brief Retrieves the corresponding NetModel interface for a given interface object path.
++ *
++ * This function searches for a NetModel interface that matches the specified interface object path
++ * and returns its path in the output parameter.
++ *
++ * @param[in]  intf_obj_path  The interface object path to search for.
++ * @param[out] nm_intf_path   A pointer to an amxc_string_t that will store the found NetModel interface path.
++ *
++ * @return int 0 on success, -1 on failure.
++ */
++int get_corresponding_nm_intf(const char* intf_obj_path, amxc_string_t* nm_intf_path ) {
++    int rv = -1;
++    amxc_string_t search_path;
++    amxc_var_t nm_intf;
++
++    when_null_trace(nm_intf_path, exit, ERROR, "nm_intf_path is NULL");
++
++    amxc_var_init(&nm_intf);
++    amxc_string_init(&search_path, 0);
++    amxc_string_init(nm_intf_path, 0);
++
++    amxc_string_setf(&search_path, "NetModel.Intf.['Device.%s' in InterfacePath].", intf_obj_path);
++
++    rv = amxb_get(netmodel_get_amxb_bus(), amxc_string_get(&search_path, 0), 0, &nm_intf, 5);
++    when_failed_trace(rv, exit, ERROR, "Failed to search for Netmodel interface: search path: %s", amxc_string_get(&search_path, 0));
++
++    SAH_TRACEZ_INFO(ME, "Found '%s' ", amxc_var_key(GETP_ARG(&nm_intf, "0.0")));
++    when_true_trace(str_empty(amxc_var_key(GETP_ARG(&nm_intf, "0.0"))), exit, ERROR, "Netmodel interface not found");
++    amxc_string_setf(nm_intf_path, "%s", amxc_var_key(GETP_ARG(&nm_intf, "0.0")));
++    rv = 0;
++exit:
++    amxc_string_clean(&search_path);
++    amxc_var_clean(&nm_intf);
++    return rv;
++}
++/**
++ * @brief Callback function for name change events on  CM's corresponding NetModel Interface.
++
++ * @param[in] sig_name The name of the signal that triggered this callback (unused).
++ * @param[in] data A pointer to an amxc_var_t containing the event data.
++ * @param[in] priv A pointer to a cell_iface_t structure, which provides context for the callback.
++
++ * @return None
++*/
++static void netmodel_name_change_cb(UNUSED const char* const sig_name,
++                                    const amxc_var_t* const data,
++                                    void* const priv) {
++    when_null(data, exit);
++    when_null(priv, exit);
++
++    int rv = -1;
++    const char* nm_intf_path = GETP_CHAR(data, "path");
++    const char* name = GETP_CHAR(data, "parameters.Name.to");
++    cell_iface_t* cell_iface  = (cell_iface_t*) priv;
++    SAH_TRACEZ_INFO(ME, "Netmodel Name changed to %s!", name);
++
++    if(strncmp(name, QMAPMUX, sizeof(QMAPMUX)-1) == 0) {
++        /* set netdev flag is required to let other managers know about new qmapmux interface*/
++        update_flag(nm_intf_path, "netdev", true);
++        SAH_TRACEZ_INFO(ME, "netdev flag set!");
++    } else {
++        /* clear netdev flag is required as qmapmux interface is no longer exist*/
++        SAH_TRACEZ_INFO(ME, "netdev flag cleared!");
++        update_flag(nm_intf_path, "netdev", false);
++    }
++
++
++    // unsubscribe
++    if (cell_iface->nm_name_subscription != NULL) {
++        rv = amxb_subscription_delete(&(cell_iface->nm_name_subscription));
++        cell_iface->nm_name_subscription = NULL;
++        when_failed_trace(rv, exit, ERROR, "failed to unsubscribe name change event from netmodel intf");
++    }
++exit:
++    return;
++}
++
++static void nm_subscribe_for_name_param(const char* intf_obj_path, cell_iface_t* cell_iface) {
++    const char* netmodel_intf = NULL;
++    amxc_string_t filter;
++    amxc_string_t nm_intf_path;
++
++    when_null(intf_obj_path, exit);
++    when_null(cell_iface, exit);
++
++    amxc_string_init(&filter, 0);
++    amxc_string_init(&nm_intf_path, 0);
++
++    // find corresponding nm path
++    get_corresponding_nm_intf(intf_obj_path, &nm_intf_path);
++    netmodel_intf = amxc_string_get(&nm_intf_path, 0);
++    when_str_empty(netmodel_intf, exit);
++
++    // subscribe
++    if (cell_iface->nm_name_subscription != NULL) {
++        amxb_subscription_delete(&(cell_iface->nm_name_subscription));
++        SAH_TRACEZ_INFO(ME, "Deleted old subscription exsits!");
++    }
++
++    amxc_string_setf(&filter, "notification in ['dm:object-changed'] && "
++                                         "path matches '%s' &&"
++                                         "contains('parameters.Name')", netmodel_intf);
++    amxb_subscription_new(&(cell_iface->nm_name_subscription), netmodel_get_amxb_bus(), "NetModel.Intf.",
++                          amxc_string_get(&filter, 0),netmodel_name_change_cb, cell_iface);
++    when_null_trace(cell_iface->nm_name_subscription, exit, WARNING, "Failed to create subscription");
++exit:
++    amxc_string_clean(&nm_intf_path);
++    amxc_string_clean(&filter);
++    return;
++}
+ void cell_iface_fill_trans(cell_iface_t* cell_iface, amxd_trans_t* trans) {
+     amxc_var_t data;
+     amxc_var_t ret;
+@@ -426,6 +570,20 @@ void cell_iface_fill_trans(cell_iface_t* cell_iface, amxd_trans_t* trans) {
+                       exit, ERROR, "retrieve-cell-bearer-info failed");
+     cellular_info_fill_trans(bearer_object, trans, BearerParams, &ret);
+ 
++   /* When a new connection is established, the netdev interface may change.
++    * To let other mgrs know about this change, we need to update the netdev flag
++    * on the corresponding NetModel interface.
++    */
++    if (strcmp(cell_iface->netdev_intf , GET_CHAR(&ret, "Name"))) {
++        SAH_TRACEZ_INFO(ME, "Name updated from libmm");
++        char *intf_obj_path = NULL;
++        intf_obj_path = amxd_object_get_path(cell_iface->object, AMXD_OBJECT_INDEXED);
++        nm_subscribe_for_name_param(intf_obj_path , cell_iface);
++        if (intf_obj_path)
++            free(intf_obj_path);
++    }
++    strncpy(cell_iface->netdev_intf, GET_CHAR(&ret, "Name"), sizeof(cell_iface->netdev_intf));
++
+     bearer_ipv4_object = amxd_object_get_child(bearer_object, "IPv4");
+     if(bearer_ipv4_object && GET_ARG(&ret, "IPv4")) {
+         cellular_info_fill_trans(bearer_ipv4_object, trans, BearerIPv4Params, GET_ARG(&ret, "IPv4"));
+diff --git a/src/cellular_utils.c b/src/cellular_utils.c
