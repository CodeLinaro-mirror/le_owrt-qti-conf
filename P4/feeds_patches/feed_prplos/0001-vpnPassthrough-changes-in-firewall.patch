++amxm_shared_object_t* qcom_so = NULL;
++//To load the controller module
++int load_controller(UNUSED amxo_parser_t* parser) {
++    int rv = 0;
++    amxd_object_t* qcom_vpn = amxd_dm_findf(fw_get_dm(), "%s", QCOM_FIREWALL);
++    amxc_var_t controllers;
++    amxc_string_t mod_path;
