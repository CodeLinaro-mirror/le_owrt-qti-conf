++    select Firewall {
++        %protected %read-only string Controller = "mod-qcom-vpnPassthrough";
++        %persistent bool X_QCOM_L2TPPassthrough {
++            default true;
++            userflags %usersetting;
++        }
++        %persistent bool X_QCOM_IPSecPassthrough {
++            default true;
++            userflags %usersetting;
++        }
++        %persistent bool X_QCOM_PPTPPassthrough {
++            default true;
++            userflags %usersetting;
++        }
++    }
++}
++%populate {
++    on event "dm:object-changed" call qcomVPNPassthrough_changed
++        filter 'path == "Firewall." && (
++                   (contains("parameters.X_QCOM_L2TPPassthrough")) ||
++                   (contains("parameters.X_QCOM_IPSecPassthrough")) ||
++                   (contains("parameters.X_QCOM_PPTPPassthrough"))
