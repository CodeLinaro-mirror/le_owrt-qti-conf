++    amxc_var_for_each(controller, &controllers) {
++        const char* name = GET_CHAR(controller, NULL);
++        amxc_string_setf(&mod_path, "%s/%s.so", module_dir, name);
++        SAH_TRACEZ_INFO(ME, "Loading controller '%s' (file = %s)", name, amxc_string_get(&mod_path, 0));
++        rv = amxm_so_open(&qcom_so, name, amxc_string_get(&mod_path, 0));
