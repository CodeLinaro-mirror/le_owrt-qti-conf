++#include "firewall/dm_qcom_vpnPassthrough.h"
++
++#define ME "VPNPassthrough"
++
++/*This function manages the VPN passthrough configuration in the firewall settings.
++ It responds to changes in the L2TP, IPSec, and PPTP passthrough parameters and
++ invokes the appropriate module functions to enable or disable these protocols.*/
++void _qcomVPNPassthrough_changed(UNUSED const char* const sig_name, const amxc_var_t* const event_data, UNUSED void* const priv) {
++    amxc_var_t* params = GET_ARG(event_data, "parameters");
++    amxc_var_t* var = NULL;
++    bool l2tp_enable = true;
++    bool ipsec_enable = true;
++    bool pptp_enable = true;
++    amxd_object_t* qcom_vpn = amxd_dm_findf(fw_get_dm(), "%s", QCOM_FIREWALL);
++    char* controller = NULL;
++    amxc_var_t ret;
++    amxc_var_t data;
++    amxc_var_init(&data);
++    amxc_var_init(&ret);
++    int r = 0;
++    if (qcom_vpn == NULL) {
++    SAH_TRACEZ_ERROR(ME, "Failed to find QCOM_FIREWALL object.");
++    goto exit;
++    }
++    controller = amxd_object_get_value(cstring_t, qcom_vpn, "Controller", NULL);
++    if (controller == NULL) {
++        SAH_TRACEZ_ERROR(ME, "Failed to get controller value");
++        goto exit;
++    }
++    var = GET_ARG(params, "X_QCOM_L2TPPassthrough");
++    if (var != NULL) {
++        l2tp_enable = GET_BOOL(var, "to");
++        // L2TP Passthrough
++        if (l2tp_enable) {
++            r = amxm_execute_function(controller, controller, "enable-l2tp-passthrough", &data, &ret);
++            when_failed_trace(r, exit, ERROR, "failed to load the l2tp enable module returns to : %d", r);
++        } else {
++            r = amxm_execute_function(controller, controller, "disable-l2tp-passthrough", &data, &ret);
++            when_failed_trace(r, exit, ERROR, "failed to load the l2tp disable module returns to : %d", r);
++        }
++    }
++    var = GET_ARG(params, "X_QCOM_IPSecPassthrough");
++    if (var != NULL) {
++        ipsec_enable = GET_BOOL(var, "to");
++        // IPSec Passthrough
++        if (ipsec_enable) {
++            r = amxm_execute_function(controller, controller, "enable-ipsec-passthrough", &data, &ret);
++            when_failed_trace(r, exit, ERROR, "failed to load the ipsec enable module returns to : %d", r);
++        } else {
++            r = amxm_execute_function(controller, controller, "disable-ipsec-passthrough", &data, &ret);
++            when_failed_trace(r, exit, ERROR, "failed to load the ipsec disable module returns to : %d", r);
++        }
++    }
++    var = GET_ARG(params, "X_QCOM_PPTPPassthrough");
++    if (var != NULL) {
++        pptp_enable = GET_BOOL(var, "to");
++        // PPTP Passthrough
++        if (pptp_enable) {
++            r = amxm_execute_function(controller, controller, "enable-pptp-passthrough", &data, &ret);
++            when_failed_trace(r, exit, ERROR, "failed to load the pptp enable module returns to : %d", r);
++        } else {
++            r = amxm_execute_function(controller, controller, "disable-pptp-passthrough", &data, &ret);
++            when_failed_trace(r, exit, ERROR, "failed to load the pptp disable module returns to : %d", r);
++        }
++    }
++exit:
++    if (controller != NULL) {
++        free(controller);
++    }
++    amxc_var_clean(&data);
++    amxc_var_clean(&ret);
++    return;
++}
+diff --git a/src/makefile b/src/makefile
+index 6fa2be2..7caa102 100644
+--- a/src/makefile
++++ b/src/makefile
+@@ -65,7 +65,7 @@ else
+ endif
+ 
+ LDFLAGS += $(STAGING_LIBDIR) -shared -fPIC
+-LDFLAGS += -lamxc -lamxd -lamxo -lamxb -lamxp -lsahtrace -lfwrules -lfwinterface -lnetmodel -lmnl -lnetfilter_queue -lipat -ltr181-schedules -lipset
++LDFLAGS += -lamxc -lamxd -lamxo -lamxb -lamxm -lamxp -lsahtrace -lfwrules -lfwinterface -lnetmodel -lmnl -lnetfilter_queue -lipat -ltr181-schedules -lipset
+ ifeq ($(CONFIG_SAH_AMX_TR181_FIREWALL_WITH_GMAP),y)
+ 	LDFLAGS += -lgmap-client
+ endif
