+index 0000000..8539384
+--- /dev/null
++++ b/mod-qcom-vpnPassthrough/src/mod_qcom_vpn.c
+@@ -0,0 +1,112 @@
++/*************************************
++  Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
++  SPDX-License-Identifier: BSD-3-Clause-Clear
++ **************************************/
++#include "mod_qcom_vpn.h"
++
++#define ME "VPNPassthrough"
++
++struct _mod_vpn {
++    amxm_shared_object_t* so;
++    void* vpn_handler;
++};
++static struct _mod_vpn vpn;
++/* To loads and calls the L2TP enable function from the shared library.*/
++int enable_l2tp_passthrough(UNUSED const char* function_name, UNUSED amxc_var_t* args, UNUSED amxc_var_t* ret) {
++    SAH_TRACEZ_INFO(ME,"L2TP enabled");
++    void (*enable_l2tp)(void) = (void (*)(void))dlsym(vpn.vpn_handler, "enable_l2tp_passthrough_execute");
++    if (!enable_l2tp) {
++        SAH_TRACEZ_ERROR(ME, "Failed to find L2TP enable function: %s", dlerror());
++        return FAILURE;
++    }
++    enable_l2tp();
++    return SUCCESS;
++}
++/* To loads and calls the L2TP disable function from the shared library.*/
++int disable_l2tp_passthrough(UNUSED const char* function_name, UNUSED amxc_var_t* args, UNUSED amxc_var_t* ret) {
++    SAH_TRACEZ_WARNING(ME,"L2TP disabled");
++    void (*disable_l2tp)(void) = (void (*)(void))dlsym(vpn.vpn_handler, "disable_l2tp_passthrough_execute");
++    if (!disable_l2tp) {
++        SAH_TRACEZ_ERROR(ME, "Failed to find L2TP disable function: %s", dlerror());
++        return FAILURE;
++    }
++    disable_l2tp();
++    return SUCCESS;
++}
++/* To loads and calls the IPsec enable function from the shared library.*/
++int enable_ipsec_passthrough(UNUSED const char* function_name, UNUSED amxc_var_t* args, UNUSED amxc_var_t* ret) {
++    SAH_TRACEZ_INFO(ME,"ipsec enabled");
++    void (*enable_ipsec)(void) = (void (*)(void))dlsym(vpn.vpn_handler, "enable_ipsec_passthrough_execute");
++    if (!enable_ipsec) {
++        SAH_TRACEZ_ERROR(ME, "Failed to find ipsec enable function: %s", dlerror());
++        return FAILURE;
++    }
++    enable_ipsec();
++    return SUCCESS;
++}
++/* To loads and calls the IPsec disable function from the shared library.*/
++int disable_ipsec_passthrough(UNUSED const char* function_name, UNUSED amxc_var_t* args, UNUSED amxc_var_t* ret) {
++    SAH_TRACEZ_WARNING(ME,"ipsec disabled");
++    void (*disable_ipsec)(void) = (void (*)(void))dlsym(vpn.vpn_handler, "disable_ipsec_passthrough_execute");
++    if (!disable_ipsec) {
++        SAH_TRACEZ_ERROR(ME, "Failed to find ipsec disable function: %s", dlerror());
++        return FAILURE;
++    }
++    disable_ipsec();
++    return SUCCESS;
++}
++/* To loads and calls the PPTP enable function from the shared library.*/
++int enable_pptp_passthrough(UNUSED const char* function_name, UNUSED amxc_var_t* args, UNUSED amxc_var_t* ret) {
++    SAH_TRACEZ_INFO(ME,"PPTP enabled");
++    void (*enable_pptp)(void) = (void (*)(void))dlsym(vpn.vpn_handler, "enable_pptp_passthrough_execute");
++    if (!enable_pptp) {
++        SAH_TRACEZ_ERROR(ME, "Failed to find pptp enable function: %s", dlerror());
++        return FAILURE;
++    }
++    enable_pptp();
++    return SUCCESS;
++}
++/* To loads and calls the PPTP disable function from the shared library.*/
++int disable_pptp_passthrough(UNUSED const char* function_name, UNUSED amxc_var_t* args, UNUSED amxc_var_t* ret) {
++    SAH_TRACEZ_WARNING(ME,"pptp disabled");
++    void (*disable_pptp)(void) = (void (*)(void))dlsym(vpn.vpn_handler, "disable_pptp_passthrough_execute");
++    if (!disable_pptp) {
++        SAH_TRACEZ_ERROR(ME, "Failed to find pptp disable function: %s", dlerror());
++        return FAILURE;
++    }
++    disable_pptp();
++    return SUCCESS;
++}
++/* Register the intermeadiate module for calling the generic .so file */
++static AMXM_CONSTRUCTOR vpn_module_start(void) {
++    amxm_module_t* mod = NULL;
++    vpn.so = amxm_so_get_current();
++    amxm_module_register(&mod, vpn.so, "mod-qcom-vpnPassthrough");
++    amxm_module_add_function(mod, "enable-l2tp-passthrough", enable_l2tp_passthrough);
++    amxm_module_add_function(mod, "disable-l2tp-passthrough", disable_l2tp_passthrough);
++    amxm_module_add_function(mod, "enable-ipsec-passthrough", enable_ipsec_passthrough);
++    amxm_module_add_function(mod, "disable-ipsec-passthrough", disable_ipsec_passthrough);
++    amxm_module_add_function(mod, "enable-pptp-passthrough", enable_pptp_passthrough);
++    amxm_module_add_function(mod, "disable-pptp-passthrough", disable_pptp_passthrough);
++    vpn.vpn_handler = dlopen(VPN_LIB_PATH, RTLD_LAZY);
++    if (!vpn.vpn_handler) {
++        SAH_TRACEZ_ERROR(ME, "Failed to load DL handler: %s\n", dlerror());
++        return FAILURE;
++    }
++    void (*set_chain)(void) = (void (*)(void))dlsym(vpn.vpn_handler, "setup_vpn_chains");
++    if (!set_chain) {
++        SAH_TRACEZ_ERROR(ME, "Failed to set vpn_passthrough chain: %s", dlerror());
++        return FAILURE;
++    }
++    set_chain();
++    SAH_TRACEZ_INFO(ME," VPN Passthrough controller initialized");
++    return SUCCESS;
++}
++static AMXM_DESTRUCTOR vpn_module_stop(void) {
++    if(vpn.vpn_handler){
++        dlclose(vpn.vpn_handler);
++        vpn.vpn_handler = NULL;
++    }
++    SAH_TRACEZ_INFO(ME," VPN Passthrough controller stopped");
++    return SUCCESS;
++}
