+From 5d3304ef367f49bf2325b1a678ed5359d0981efd Mon Sep 17 00:00:00 2001
+From: HuaWen CHEN <quic_huawenc@quicinc.com>
+Date: Sun, 15 Oct 2023 23:38:03 +0800
+Subject: [PATCH] [PATCH] meta-qti-data : removing internal dependency
+
+---
+ Makefile.linux | 3 ++-
+ 1 file changed, 2 insertions(+), 1 deletion(-)
+
+diff --git a/Makefile.linux b/Makefile.linux
+index b35b1e5..d800644 100644
+--- a/Makefile.linux
++++ b/Makefile.linux
+@@ -29,6 +29,7 @@ CFLAGS ?= -Os
+ #CFLAGS += -fno-common
+ #CFLAGS += -fstack-protector -fPIE
+ #CFLAGS += -D_FORTIFY_SOURCE=2
++CFLAGS += -DIPTABLES_143
+ CPPFLAGS += -D_GNU_SOURCE
+ CFLAGS += -Wall
+ CFLAGS += -Wextra -Wstrict-prototypes -Wdeclaration-after-statement
+@@ -70,7 +71,7 @@ NETFILTER_SCRIPTS = $(addprefix $(SRCDIR)/netfilter/, \
+ ifneq ($(IPTABLES_PCFILE_FOUND),1)
+ 
+ ifeq "$(wildcard /etc/gentoo-release )" ""
+-LDLIBS ?= -liptc
++LDLIBS ?= -lip4tc
+ else # gentoo
+ # the following is better, at least on gentoo with iptables 1.4.6
+ # see http://miniupnp.tuxfamily.org/forum/viewtopic.php?p=1618
+-- 
+2.40.0.windows.1
+
diff --git a/net/miniupnpd/patches/403-meta-qti-data-removing-internal-dependency.patch b/net/miniupnpd/patches/403-meta-qti-data-removing-internal-dependency.patch
