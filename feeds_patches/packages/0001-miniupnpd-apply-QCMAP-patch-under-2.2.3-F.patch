++'<http://[fe80::6c4f:b721:4e2d:ea6%13]:49240/urn:upnp-org:serviceId:WANIPv6FC1
++/143598522>'*/
+ start_again:
+ 	if(h->req_CallbackOff <= 0 || h->req_CallbackLen < 10)
+ 		return 0;
+@@ -571,10 +574,15 @@ start_again:
+ 	if(*p == '[') {
+ 		p++;
+ 		ipv6 = 1;
+-		while(*p != ']' && *p != '>' && i < (sizeof(addrstr)-1)
