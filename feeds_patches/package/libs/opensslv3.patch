-+static int open_devcrypto(void)
-+{
-+    int fd;
-+
-+    if (cfd >= 0)
-+        return 1;
-+
-+    if ((fd = open("/dev/crypto", O_RDWR, 0)) < 0) {
-+#ifndef ENGINE_DEVCRYPTO_DEBUG
-+        if (errno != ENOENT)
-+#endif
