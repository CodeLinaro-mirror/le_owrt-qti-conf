-+#ifdef CRIOGET
-+    if (ioctl(fd, CRIOGET, &cfd) < 0) {
-+        fprintf(stderr, "Could not create crypto fd: %s\n", strerror(errno));
-+        close(fd);
-+        cfd = -1;
-+        return 0;
-+    }
-+    close(fd);
-+#else
-+    cfd = fd;
-+#endif
-+
-+    return 1;
-+}
-+
-+static int close_devcrypto(void)
-+{
-+    int ret;
-+
-+    if (cfd < 0)
-+        return 1;
-+    ret = close(cfd);
-+    cfd = -1;
-+    if (ret != 0) {
-+        fprintf(stderr, "Error closing /dev/crypto: %s\n", strerror(errno));
-+        return 0;
-+    }
-+    return 1;
