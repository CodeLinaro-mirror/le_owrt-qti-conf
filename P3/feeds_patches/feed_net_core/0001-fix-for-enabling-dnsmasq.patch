From 6c3b5c5c479ae6a00f56365a2b5247afbe6c9d9b Mon Sep 17 00:00:00 2001
From: Bijeesh B <quic_bijeb@quicinc.com>
Date: Tue, 25 Mar 2025 19:47:48 +0530
Subject: [PATCH] Fix for Enabling dnsmasq

Fix to enabling dnsmasq for prplos.

Signed-off-by: Bijeesh B <quic_bijeb@quicinc.com>
---
 plugins/dhcpv4-manager/Config.in | 4 ++--
 plugins/dhcpv4-manager/Makefile  | 6 +++---
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/plugins/dhcpv4-manager/Config.in b/plugins/dhcpv4-manager/Config.in
index e4a19b8..2f2c614 100644
--- a/plugins/dhcpv4-manager/Config.in
+++ b/plugins/dhcpv4-manager/Config.in
@@ -13,11 +13,11 @@ config SAH_SERVICES_AMX-DHCPV4-MANAGER
 
 config SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_USER
     string "User will be used for the dhcpv4-manager plugin"
-    default "tr181_app"
+    default "root"
 
 config SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_GROUP
     string "Group will be used for the dhcpv4-manager plugin"
-    default "tr181_app"
+    default "root"
 
 endmenu
 
diff --git a/plugins/dhcpv4-manager/Makefile b/plugins/dhcpv4-manager/Makefile
index f4cb914..6f09e43 100644
--- a/plugins/dhcpv4-manager/Makefile
+++ b/plugins/dhcpv4-manager/Makefile
@@ -65,18 +65,18 @@ define Package/$(PKG_NAME)/description
 endef
 
 define Build/Compile
-	$(call Build/Compile/Default, STAGINGDIR=$(STAGING_DIR) CONFIGDIR=$(STAGING_DIR) PKG_CONFIG_PATH=$(STAGING_DIR)/usr/lib/pkgconfig LIBDIR=/usr/lib INSTALL_LIB_DIR=/lib INSTALL_BIN_DIR=/bin RAW_VERSION=$(PKG_VERSION) HARDCO_HAL_DIR=$(STAGING_DIR)/usr/include CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_USER=$(CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_USER) CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_GROUP=$(CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_GROUP))
+	$(call Build/Compile/Default, STAGINGDIR=$(STAGING_DIR) CONFIGDIR=$(STAGING_DIR) PKG_CONFIG_PATH=$(STAGING_DIR)/usr/lib/pkgconfig LIBDIR=/usr/lib INSTALL_LIB_DIR=/lib INSTALL_BIN_DIR=/bin RAW_VERSION=$(PKG_VERSION) HARDCO_HAL_DIR=$(STAGING_DIR)/usr/include CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_USER=root CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_GROUP=root)
 endef
 
 define Build/Install
-	$(call Build/Install/Default, install INSTALL=install D=$(PKG_INSTALL_DIR) DEST=$(PKG_INSTALL_DIR) STAGINGDIR=$(STAGING_DIR) CONFIGDIR=$(STAGING_DIR) PV=$(PKG_VERSION) PKG_CONFIG_LIBDIR=$(STAGING_DIR)/usr/lib/pkgconfig LIBDIR=/usr/lib INSTALL_LIB_DIR=/lib INSTALL_BIN_DIR=/bin RAW_VERSION=$(PKG_VERSION) HARDCO_HAL_DIR=$(STAGING_DIR)/usr/include CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_USER=$(CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_USER) CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_GROUP=$(CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_GROUP))
+	$(call Build/Install/Default, install INSTALL=install D=$(PKG_INSTALL_DIR) DEST=$(PKG_INSTALL_DIR) STAGINGDIR=$(STAGING_DIR) CONFIGDIR=$(STAGING_DIR) PV=$(PKG_VERSION) PKG_CONFIG_LIBDIR=$(STAGING_DIR)/usr/lib/pkgconfig LIBDIR=/usr/lib INSTALL_LIB_DIR=/lib INSTALL_BIN_DIR=/bin RAW_VERSION=$(PKG_VERSION) HARDCO_HAL_DIR=$(STAGING_DIR)/usr/include CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_USER=root CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_GROUP=root)
 
 	$(call SAHInit/Install)
 	$(call SAHBackupRestore/Install)
 endef
 
 define Build/InstallDev
-	$(call Build/Install/Default, install INSTALL=install D=$(STAGING_DIR) DEST=$(STAGING_DIR) STAGINGDIR=$(STAGING_DIR) CONFIGDIR=$(STAGING_DIR) PV=$(PKG_VERSION) PKG_CONFIG_LIBDIR=$(STAGING_DIR)/usr/lib/pkgconfig LIBDIR=/usr/lib INSTALL_LIB_DIR=/lib INSTALL_BIN_DIR=/bin RAW_VERSION=$(PKG_VERSION) HARDCO_HAL_DIR=$(STAGING_DIR)/usr/include CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_USER=$(CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_USER) CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_GROUP=$(CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_GROUP))
+	$(call Build/Install/Default, install INSTALL=install D=$(STAGING_DIR) DEST=$(STAGING_DIR) STAGINGDIR=$(STAGING_DIR) CONFIGDIR=$(STAGING_DIR) PV=$(PKG_VERSION) PKG_CONFIG_LIBDIR=$(STAGING_DIR)/usr/lib/pkgconfig LIBDIR=/usr/lib INSTALL_LIB_DIR=/lib INSTALL_BIN_DIR=/bin RAW_VERSION=$(PKG_VERSION) HARDCO_HAL_DIR=$(STAGING_DIR)/usr/include CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_USER=root CONFIG_SAH_SERVICES_AMX-DHCPV4-MANAGER_RUN_AS_GROUP=root)
 endef
 
 define Package/$(PKG_NAME)/install
